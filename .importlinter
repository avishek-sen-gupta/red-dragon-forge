[importlinter]
root_packages =
    cics
    squall
    jackal
    cobble
    catnip
    red_dragon_forge
    interpreter

[importlinter:contract:cicada-squall-jackal-independence]
name = Cicada, Squall, and Jackal must not import each other
type = independence
modules =
    cics
    squall
    jackal

[importlinter:contract:vsam-bms-independence]
name = VSAM and BMS subsystems must not import each other
type = independence
modules =
    cics.vsam
    cics.bms

[importlinter:contract:builtins-no-dispatcher]
name = Builtins must not import the dispatcher (avoid circular dependency)
type = forbidden
source_modules =
    cics.builtins
forbidden_modules =
    cics.dispatcher

[importlinter:contract:parser-backends-independence]
name = SQL parser and DB backends must not import each other
type = independence
modules =
    squall.parser
    squall.backends

[importlinter:contract:vocabulary-leaves]
name = backend and parser.sql_model are leaf vocabulary — must not import other squall modules
type = forbidden
source_modules =
    squall.backend
    squall.parser.sql_model
forbidden_modules =
    squall.binding
    squall.builtins
    squall.backends
    squall.parser.parse
    squall.preprocess
    squall.strategy
    squall.dclgen

[importlinter:contract:layered-architecture]
name = Layers: orchestration -> execution -> catalog -> model
type = layers
layers =
    jackal.cli
    jackal.runner
    jackal.cobol_step : jackal.utilities
    jackal.catalog
    jackal.model

[importlinter:contract:jcl-idcams-independence]
name = JCL parser and IDCAMS subsystems must not import each other
type = independence
modules =
    jackal.jcl
    jackal.idcams

[importlinter:contract:model-results-are-leaves]
name = model and results are leaf vocabulary — must not import other jackal modules
type = forbidden
source_modules =
    jackal.model
    jackal.results
forbidden_modules =
    jackal.catalog
    jackal.runner
    jackal.cli
    jackal.cobol_step
    jackal.utilities
    jackal.idcams
    jackal.jcl

# ── Cobble ────────────────────────────────────────────────────────────────────
# Cobble parses, walks the ASG and emits a graph. It never lowers to IR and never
# executes, so it reaches for the workspace's STATIC surface only: red-dragon's
# cobol_asg package, cicada's EXEC CICS parsing, jackal's JCL model and parsing,
# and squall's statement vocabulary. squall.parser is on that surface rather than
# the forbidden list below: its whole import closure is stdlib, lark and its own
# sql_model, so it is a grammar-based text-to-model parser, not a runtime, and
# parsing is what cobble does for a living.
#
# Import-linter enforces prohibitions, not permissions, so only the forbidden
# lists below are machine-checked. The allowed surface -- cobol_asg.*,
# cobol_memory, cics.{cics_parser,cics_visitor,cics_grammar,csd_parse,statements,
# bms}, bms_copybook_gen, jackal.{model,dsn,value_parts,tso,jcl.*} and
# squall.{statements,parser} -- is stated here because it is what a future extraction of a
# lean core would have to contain. Keeping the two in step is a review
# obligation, not an automated one.

[importlinter:contract:cobble-no-interpreter]
name = Cobble must not import the interpreter
type = forbidden
source_modules =
    cobble
forbidden_modules =
    interpreter

[importlinter:contract:cobble-no-runtime]
name = Cobble is static analysis — it must not reach into any runtime
type = forbidden
source_modules =
    cobble
forbidden_modules =
    cics.dispatcher
    cics.vsam
    cics.builtins
    cics.bootstrap
    cics.conversational
    cics.strategy
    cics.coprocessor
    cics.terminal
    cics.le_stubs
    cics.vm_init
    cics.tn3270
    cics.screen
    jackal.runner
    jackal.cli
    jackal.cobol_step
    jackal.catalog
    jackal.idcams
    jackal.utilities
    jackal.results
    squall.backend
    squall.backends
    squall.binding
    squall.builtins
    squall.connector
    squall.coprocessor
    squall.dclgen
    squall.preprocess
    squall.strategy
    catnip
    red_dragon_forge

[importlinter:contract:nothing-imports-cobble]
name = Cobble is a leaf consumer — nothing in the workspace may import it
type = forbidden
source_modules =
    cics
    squall
    jackal
    catnip
    red_dragon_forge
forbidden_modules =
    cobble

[importlinter:contract:tn3270-is-an-adapter]
name = The runtime and the screen model must not import the TN3270 adapter
type = forbidden
source_modules =
    cics.screen
    cics.builtins
    cics.dispatcher
    cics.strategy
    cics.bms
    cics.input_event
forbidden_modules =
    cics.tn3270

[importlinter:contract:catnip-imports-no-runtime]
name = catnip is the system's catalog — it imports no runtime
type = forbidden
source_modules =
    catnip
forbidden_modules =
    cics
    squall
    jackal
    cobble
    red_dragon_forge
