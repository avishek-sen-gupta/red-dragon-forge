[importlinter]
root_packages =
    cobble
# The five graph consumers import CorpusIndex under TYPE_CHECKING only, purely
# to annotate the index they are handed. Counting those edges makes the
# consumer-independence and leaf contracts break on a dependency that does not
# exist at runtime. Exempted here rather than left broken; the next commit
# removes the exemption by splitting corpus_index so the runtime cycle it is
# papering over is gone.
exclude_type_checking_imports = True

[importlinter:contract:interpreter-is-leaf]
name = interpreter must not import other cobble modules
type = forbidden
source_modules =
    cobble.interpreter
forbidden_modules =
    cobble.cics
    cobble.jackal
    cobble.knowledge_graph
    cobble.bms_copybook_gen
    cobble.sql

[importlinter:contract:bms-copybook-gen-is-leaf]
name = bms_copybook_gen must not import other cobble modules
type = forbidden
source_modules =
    cobble.bms_copybook_gen
forbidden_modules =
    cobble.cics
    cobble.interpreter
    cobble.jackal
    cobble.knowledge_graph
    cobble.sql

# cobble.sql holds one coprocessor's parse-time DialectParser. Like the
# interpreter it is a leaf: cobble.cics imports it to register the parser, never
# the other way round. Deliberately absent from consumer-independence, which
# governs the three graph consumers.
[importlinter:contract:sql-is-leaf]
name = sql must not import other cobble modules
type = forbidden
source_modules =
    cobble.sql
forbidden_modules =
    cobble.bms_copybook_gen
    cobble.cics
    cobble.interpreter
    cobble.jackal
    cobble.knowledge_graph

[importlinter:contract:consumer-independence]
name = cics, jackal, and knowledge_graph must not import each other
type = independence
modules =
    cobble.cics
    cobble.jackal
    cobble.knowledge_graph
