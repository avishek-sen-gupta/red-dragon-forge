// IDCAMS control-language grammar
// Continuation: a trailing "-" before newline joins lines (stripped via %ignore)

// A record (line) ends a command; "-" at a line's end continues it (AMS p. xxvii, ch. 2)
start: _NL* (command _NL+)* command?

command: _simple | if_matched | if_open
_simple: delete_cmd
       | define_cmd
       | define_gdg
       | repro_cmd
       | verify_cmd
       | set_cmd
       | cancel_cmd

// DELETE dsname -\n CLUSTER [PURGE]
// CLUSTER is the default entry type and may be omitted (real IDCAMS
// accepts a bare "DELETE dsname" with no trailing type keyword).
// PURGE forces deletion even if the entry's retention period hasn't
// expired -- given as its own rule (not a filtered literal) so the
// transformer can detect its presence.
delete_cmd: "DELETE" DSNAME "CLUSTER"? purge_trailer?
purge_trailer: "PURGE"

// DEFINE CLUSTER ( params ) trailers
define_cmd: _DEFINE "CLUSTER" "(" _param+ ")" _trailer*

// DEFINE GENERATIONDATAGROUP ( params ) [CATALOG(catname)]  (AMS ch. 15)
// OWNER, PURGE|NOPURGE, NOEXTENDED and CATALOG are accepted, not modelled.
define_gdg: _DEFINE ("GENERATIONDATAGROUP" | "GDG") "(" _gdg_param+ ")" _catalog?

_DEFINE: "DEFINE" | "DEF"

_gdg_param: name_param
          | limit_param
          | empty_param
          | noempty_param
          | noscratch_param
          | scratch_param
          | fifo_param
          | lifo_param
          | extended_param
          | _gdg_ignored

limit_param:     ("LIMIT" | "LIM") "(" INT ")"
empty_param:     "EMPTY" | "EMP"
noempty_param:   "NOEMPTY" | "NEMP"
noscratch_param: "NOSCRATCH" | "NSCR"
scratch_param:   "SCRATCH" | "SCR"
fifo_param:      "FIFO"
lifo_param:      "LIFO"
extended_param:  "EXTENDED" | "EXT"
_gdg_ignored:    "OWNER" "(" INNER_TEXT ")"
             | "PURGE" | "NOPURGE" | "NOEXTENDED" | "NEXT"
_catalog:        ("CATALOG" | "CAT") "(" INNER_TEXT ")"

_param: name_param
      | keys_param
      | recordsize_param
      | _ignored_param

name_param:       "NAME" "(" DSNAME ")"
keys_param:       "KEYS" "(" INT INT ")"
recordsize_param: "RECORDSIZE" "(" INT INT ")"

// Consume unmodelled keywords with optional parenthesised argument
// INNER_TEXT is one-or-more non-paren chars; used when arg has no nested parens
_ignored_param: IDCAMS_WORD ("(" INNER_TEXT ")")?

// REPRO INFILE(dd) OUTFILE(dd)
repro_cmd: "REPRO" "INFILE" "(" NAME ")" "OUTFILE" "(" NAME ")"

// IF {LASTCC|MAXCC} op n THEN [command | DO ... END] [ELSE [command | DO ... END]]  (AMS ch. 2)
// A THEN or ELSE with nothing after it in its record is the null command. Each ELSE takes the
// nearest unmatched THEN: an IF that has its ELSE ("matched") is the only kind a THEN may hold
// when an ELSE follows it.
if_matched: _if_head then_closed else_closed
if_open: _if_head then_any
       | _if_head then_closed else_open
_if_head: "IF" IF_FIELD OP INT "THEN"
then_closed: _closed?
then_any: _any?
else_closed: _NL* "ELSE" _closed?
else_open: _NL* "ELSE" if_open
_closed: _simple | if_matched | do_block
_any: _simple | if_matched | if_open | do_block
do_block: "DO" _NL+ (command _NL+)* "END"
IF_FIELD: "MAXCC" | "LASTCC"

set_cmd: "SET" IF_FIELD ("=" | "EQ") INT
cancel_cmd: "CANCEL"

// VERIFY {FILE(ddname) | DATASET(entryname)} [RECOVER]  (AMS ch. 34)
verify_cmd: ("VERIFY" | "VFY") (verify_file | verify_dataset) "RECOVER"?
verify_file: "FILE" "(" NAME ")"
verify_dataset: ("DATASET" | "DS") "(" DSNAME ")"

// Trailers: DATA (NAME(dsn)) and INDEX (NAME(dsn))
// Expanded explicitly: outer paren wraps keyword(dsn) call
_trailer: _data_trailer | _index_trailer
_data_trailer:  "DATA"  "(" "NAME" "(" DSNAME ")" ")"
_index_trailer: "INDEX" "(" "NAME" "(" DSNAME ")" ")"

// One-or-more non-paren characters (content inside simple parentheses)
INNER_TEXT: /[^)]+/

OP:        "LE" | "LT" | "GE" | "GT" | "EQ" | "NE" | "=" | "¬=" | ">=" | "<=" | ">" | "<"

// A dataset-qualified name: one or more NAME segments separated by dots
DSNAME:    /[A-Z#@$][A-Z0-9#@$]*(\.[A-Z#@$][A-Z0-9#@$]*)*/

// Simple (unqualified) name: used for DD names
NAME:      /[A-Z#@$][A-Z0-9#@$]*/

// Positive integer
INT:       /[0-9]+/

// Keywords that appear as unmodelled DEFINE parameters (INDEXED, CYLINDERS, etc.)
// Must not match reserved words handled by literal rules above.
IDCAMS_WORD: /[A-Z][A-Z0-9]*/

_NL: /[ \t]*\r?\n/

// Strip blanks and continuations (a "-" ending a line joins the next)
%ignore /[ \t]+/
%ignore /-[ \t]*\r?\n/
