// jackal/jackal/idcams/grammar/ams.lark
// Shared terminals and lexical rules for the comprehensive IDCAMS grammar.
// Command-specific rules are added here by later tasks (Tasks 2-11), each
// contributing its own `command:` alternative and rule definitions.

start: command+

command: modal_command | set_command | define_cluster | define_alternateindex
       | define_gdg | define_nonvsam | define_path | delete | alter | repro
       | print | listcat | export | import_cmd | verify | bldindex
                                       // set_command is
                                       // placeholder scaffolding (like
                                       // modal_command) so start.lark is
                                       // parseable standalone during Task 1.

// Not prefixed with "?": as the top-level `start` rule in standalone
// lexical tests, a "?"-inlined single-child rule collapses to a bare
// Token with no `.children`, which the tests need. Non-standalone uses
// (nested inside other rules added by later tasks) still see this as an
// ordinary one-child Tree, which is equally usable.
value: NAME | GENERIC_NAME | QUOTED_STRING | HEX_LITERAL | BIN_LITERAL | INT

modal_command: "CANCEL"   // minimal placeholder so start.lark is parseable
                          // standalone during Task 1; replaced/extended by
                          // Task 11's real modal_command rule.

set_command: "SET" NAME "=" INT  // minimal placeholder covering IDCAMS's
                                  // SET MAXCC=n idiom, used here only to
                                  // exercise the semicolon-terminator and
                                  // inline-comment lexical rules standalone
                                  // during Task 1.

// ---------------------------------------------------------------------
// DEFINE CLUSTER (Task 2)
//
// DEFINE CLUSTER ( cluster_param* ) [DATA ( data_param* )] [INDEX ( index_param* )]
//
// cluster_param covers the ~50 CLUSTER-level parameters. DATA(...) and
// INDEX(...) are separate trailer clauses (siblings of the CLUSTER
// parens, not nested inside them) each with their OWN parameter rule
// (data_param / index_param) -- deliberately NOT shared, since INDEX(...)
// rejects SPANNED/NONSPANNED, ERASE/NOERASE, BUFFERSPACE, FREESPACE,
// KEYS, RECORDSIZE, and SPEED/RECOVERY, which are meaningless for an
// index component per the IDCAMS manual.
//
// CYLINDERS|KILOBYTES|MEGABYTES|RECORDS|TRACKS is one rule (space_choice)
// with five alternatives -- a genuine mutually-exclusive choice, not five
// independently-optional rules that could all match at once. Likewise
// INDEXED|LINEAR|NONINDEXED|NUMBERED|ZFS (organization_param).
//
// Real DEFINE CLUSTER/DATA/INDEX syntax lets these mutually-exclusive
// choices appear in any position relative to the other (freely repeatable)
// parameters -- so `cluster_param*` alone can't enforce "at most one
// space_choice" (Lark/Earley repetition has no built-in cardinality limit
// across alternatives). Instead the sequences below are small right-
// recursive state machines: `cluster_seq_*` tracks "has a space_choice
// been consumed yet?" x "has an organization choice been consumed yet?"
// (four states); `data_seq_*`/`index_seq_*` track only the space_choice
// dimension (DATA/INDEX have no organization choice). Each state only
// offers a transition into "that choice consumed" once, so a second
// CYLINDERS/TRACKS/etc. (or a second INDEXED/LINEAR/etc.) on the same
// command has no valid parse -- a genuine LarkError, not silent last-wins.
define_cluster: "DEFINE" "CLUSTER" "(" cluster_seq_00 ")" component_clause*

component_clause: data_clause | index_clause
data_clause:  "DATA"  "(" data_seq_0 ")"
index_clause: "INDEX" "(" index_seq_0 ")"

// state: neither space_choice nor organization_param consumed yet
cluster_seq_00: cluster_param cluster_seq_00
              | space_choice cluster_seq_10
              | organization_param cluster_seq_01
              |
// state: space_choice consumed, organization_param not yet
cluster_seq_10: cluster_param cluster_seq_10
              | organization_param cluster_seq_11
              |
// state: organization_param consumed, space_choice not yet
cluster_seq_01: cluster_param cluster_seq_01
              | space_choice cluster_seq_11
              |
// state: both consumed -- only the freely-repeatable params remain
cluster_seq_11: cluster_param cluster_seq_11
              |

// DATA(...)/INDEX(...) only track the space_choice dimension (no
// organization choice at the component level).
data_seq_0: data_param data_seq_0
          | space_choice data_seq_1
          |
data_seq_1: data_param data_seq_1
          |

index_seq_0: index_param index_seq_0
           | space_choice index_seq_1
           |
index_seq_1: index_param index_seq_1
           |

cluster_param: name_param
             | volumes_param
             | account_param
             | bufferspace_param
             | bwo_param
             | catalog_param
             | cisz_param
             | database_format_param
             | keyname_param
             | keynameu_param
             | dataclass_param
             | eattr_param
             | erase_param
             | exceptionexit_param
             | file_param
             | freespace_param
             | frlog_param
             | keylabel_param
             | keys_param
             | log_param
             | logreplicate_param
             | logstreamid_param
             | managementclass_param
             | model_param
             | owner_param
             | recatalog_param
             | recordsize_param
             | reuse_param
             | rls_param
             | shareoptions_param
             | spanned_param
             | speed_param
             | storageclass_param
             | retention_param
             | writecheck_param
             | obsolete_ignored_param

// DataComponent: CLUSTER-level params minus everything that only makes
// sense at the cluster/catalog level (ACCOUNT, BWO, CATALOG, DATABASE,
// DATACLASS, EATTR, FRLOG, organization, KEYLABEL, LOG*, MANAGEMENTCLASS,
// RECATALOG, RLS*, STORAGECLASS, retention).
data_param: name_param
          | volumes_param
          | bufferspace_param
          | cisz_param
          | erase_param
          | exceptionexit_param
          | file_param
          | freespace_param
          | keys_param
          | model_param
          | owner_param
          | recordsize_param
          | reuse_param
          | shareoptions_param
          | spanned_param
          | speed_param
          | writecheck_param
          | obsolete_ignored_param

// IndexComponent: strict subset of data_param -- no SPANNED/NONSPANNED,
// ERASE/NOERASE, BUFFERSPACE, FREESPACE, KEYS, RECORDSIZE, SPEED/RECOVERY.
index_param: name_param
           | volumes_param
           | cisz_param
           | exceptionexit_param
           | file_param
           | model_param
           | owner_param
           | reuse_param
           | shareoptions_param
           | writecheck_param
           | obsolete_ignored_param

name_param: "NAME" "(" NAME ")"

cylinders_alloc: "CYLINDERS" "(" INT INT? ")"
kilobytes_alloc: "KILOBYTES" "(" INT INT? ")"
megabytes_alloc: "MEGABYTES" "(" INT INT? ")"
records_alloc:   "RECORDS"   "(" INT INT? ")"
tracks_alloc:    "TRACKS"    "(" INT INT? ")"
space_choice: cylinders_alloc | kilobytes_alloc | megabytes_alloc | records_alloc | tracks_alloc

volumes_param: "VOLUMES" "(" NAME+ ")"

account_param:       "ACCOUNT" "(" NAME ")"
bufferspace_param:   "BUFFERSPACE" "(" INT ")"
bwo_param:           "BWO" "(" BWO_VALUE ")"
catalog_param:       "CATALOG" "(" NAME ")"
cisz_param:          "CONTROLINTERVALSIZE" "(" INT ")"
database_format_param: "DATABASE" "(" DATABASE_FORMAT ")"
keyname_param:       "KEYNAME" "(" NAME ")"
keynameu_param:      "KEYNAMEU" "(" NAME ")"
dataclass_param:     "DATACLASS" "(" NAME ")"
eattr_param:         "EATTR" "(" EATTR_VALUE ")"
erase_param:         "ERASE" -> erase_flag
                    | "NOERASE" -> noerase_flag
exceptionexit_param: "EXCEPTIONEXIT" "(" NAME ")"
file_param:          "FILE" "(" NAME ")"
freespace_param:     "FREESPACE" "(" INT INT ")"
frlog_param:         "FRLOG" "(" FRLOG_VALUE ")"
organization_param:  ORG_VALUE
keylabel_param:      "KEYLABEL" "(" NAME ")"
keys_param:          "KEYS" "(" INT INT ")"
log_param:           "LOG" "(" LOG_VALUE ")"
logreplicate_param:  "LOGREPLICATE" -> logreplicate_flag
                    | "NOLOGREPLICATE" -> nologreplicate_flag
logstreamid_param:   "LOGSTREAMID" "(" NAME ")"
managementclass_param: "MANAGEMENTCLASS" "(" NAME ")"
model_param:         "MODEL" "(" NAME NAME? ")"
owner_param:         "OWNER" "(" NAME ")"
recatalog_param:     "RECATALOG" -> recatalog_flag
                    | "NORECATALOG" -> norecatalog_flag
recordsize_param:    "RECORDSIZE" "(" INT INT ")"
reuse_param:         "REUSE" -> reuse_flag
                    | "NOREUSE" -> noreuse_flag
rls_param:           "RLSQUIESCE" -> rlsquiesce_flag
                    | "RLSENABLE" -> rlsenable_flag
shareoptions_param:  "SHAREOPTIONS" "(" INT INT? ")"
spanned_param:       "SPANNED" -> spanned_flag
                    | "NONSPANNED" -> nonspanned_flag
speed_param:         "SPEED" -> speed_flag
                    | "RECOVERY" -> recovery_flag
storageclass_param:  "STORAGECLASS" "(" NAME ")"
retention_param:     "TO" "(" INT ")" -> to_retention
                    | "FOR" "(" INT ")" -> for_retention
writecheck_param:    "WRITECHECK" -> writecheck_flag
                    | "NOWRITECHECK" -> nowritecheck_flag

// Obsolete parameters that real (old) JCL may still contain: accepted so
// parsing does not fail, but carry no semantic value on DefineCluster
// (unlike DefineAlternateIndex, which has dedicated *_ignored fields).
obsolete_ignored_param: "IMBED" -> obsolete_ignored
                       | "NOIMBED" -> obsolete_ignored
                       | "KEYRANGES" "(" INT+ ")" -> obsolete_ignored
                       | "KEYRANGE" "(" INT+ ")" -> obsolete_ignored
                       | "ORDERED" -> obsolete_ignored
                       | "UNORDERED" -> obsolete_ignored
                       | "REPLICATE" -> obsolete_ignored
                       | "NOREPLICATE" -> obsolete_ignored

// ---------------------------------------------------------------------
// DEFINE ALTERNATEINDEX (Task 3)
//
// DEFINE ALTERNATEINDEX ( aix_param* ) [DATA ( aixdata_param* )] [INDEX ( aixindex_param* )]
//
// Two independent mutually-exclusive choices can appear at the AIX
// (command) level -- the space_choice (CYLINDERS|KILOBYTES|...,
// shared with DEFINE CLUSTER) and ALTKEYS|ALTKEYSU (RLS VSAMDB
// alternate-key-name lists, "already UTF-8" vs not). Same rationale as
// cluster_seq_*/data_seq_*/index_seq_* above: aix_param* alone can't
// enforce "at most one of these", so aix_seq_* is a small right-
// recursive state machine tracking both dimensions (space_choice
// consumed? x altkey_choice consumed?) -- four states, same shape as
// cluster_seq_00/10/01/11. aixdata_seq_*/aixindex_seq_* only track the
// space_choice dimension, mirroring data_seq_*/index_seq_*.
define_alternateindex: "DEFINE" "ALTERNATEINDEX" "(" aix_seq_00 ")" aix_component_clause*

aix_component_clause: aixdata_clause | aixindex_clause
aixdata_clause:  "DATA"  "(" aixdata_seq_0 ")"
aixindex_clause: "INDEX" "(" aixindex_seq_0 ")"

altkey_choice: altkeys_param | altkeysu_param

// state: neither space_choice nor altkey_choice consumed yet
aix_seq_00: aix_param aix_seq_00
          | space_choice aix_seq_10
          | altkey_choice aix_seq_01
          |
// state: space_choice consumed, altkey_choice not yet
aix_seq_10: aix_param aix_seq_10
          | altkey_choice aix_seq_11
          |
// state: altkey_choice consumed, space_choice not yet
aix_seq_01: aix_param aix_seq_01
          | space_choice aix_seq_11
          |
// state: both consumed -- only the freely-repeatable params remain
aix_seq_11: aix_param aix_seq_11
          |

aixdata_seq_0: aixdata_param aixdata_seq_0
             | space_choice aixdata_seq_1
             |
aixdata_seq_1: aixdata_param aixdata_seq_1
             |

aixindex_seq_0: aixindex_param aixindex_seq_0
              | space_choice aixindex_seq_1
              |
aixindex_seq_1: aixindex_param aixindex_seq_1
              |

aix_param: name_param
         | relate_param
         | volumes_param
         | bufferspace_param
         | catalog_param
         | cisz_param
         | dataclass_param
         | erase_param
         | exceptionexit_param
         | file_param
         | freespace_param
         | imbed_param
         | keyranges_param
         | keys_param
         | model_param
         | order_param
         | owner_param
         | recatalog_param
         | recordsize_param
         | replicate_param
         | reuse_param
         | shareoptions_param
         | speed_param
         | retention_param
         | uniquekey_param
         | upgrade_param
         | writecheck_param

// AixDataComponent: same shape as DataComponent minus SPANNED/NONSPANNED
// (not valid for an AIX component at all per the manual), plus
// ATTEMPTS/AUTHORIZATION/CODE/UNIQUEKEY (AIX-specific).
aixdata_param: name_param
             | volumes_param
             | attempts_param
             | authorization_param
             | bufferspace_param
             | code_param
             | cisz_param
             | erase_param
             | exceptionexit_param
             | file_param
             | freespace_param
             | keys_param
             | model_param
             | owner_param
             | recordsize_param
             | reuse_param
             | shareoptions_param
             | speed_param
             | uniquekey_param
             | writecheck_param

// AixIndexComponent: strict subset of aixdata_param -- no BUFFERSPACE,
// ERASE/NOERASE, FREESPACE, KEYS, RECORDSIZE, SPEED/RECOVERY, UNIQUEKEY.
aixindex_param: name_param
              | volumes_param
              | attempts_param
              | authorization_param
              | code_param
              | cisz_param
              | exceptionexit_param
              | file_param
              | model_param
              | owner_param
              | reuse_param
              | shareoptions_param
              | writecheck_param

relate_param: "RELATE" "(" NAME ")"

altkey_entry: NAME ALTKEY_ACTION
altkeys_param:  "ALTKEYS"  "(" altkey_entry+ ")"
altkeysu_param: "ALTKEYSU" "(" altkey_entry+ ")"

attempts_param:     "ATTEMPTS" "(" INT ")"
authorization_param: "AUTHORIZATION" "(" NAME QUOTED_STRING? ")"
code_param:          "CODE" "(" NAME ")"

imbed_param:      "IMBED" -> imbed_flag
                 | "NOIMBED" -> noimbed_flag
keyranges_param:  "KEYRANGES" "(" INT+ ")" -> keyranges_ignored
                 | "KEYRANGE"  "(" INT+ ")" -> keyranges_ignored
order_param:      "ORDERED" -> order_ignored_flag
                 | "UNORDERED" -> order_ignored_flag
replicate_param:  "REPLICATE" -> replicate_ignored_flag
                 | "NOREPLICATE" -> replicate_ignored_flag
uniquekey_param:  "UNIQUEKEY" -> uniquekey_flag
                 | "NONUNIQUEKEY" -> nonuniquekey_flag
upgrade_param:    "UPGRADE" -> upgrade_flag
                 | "NOUPGRADE" -> noupgrade_flag

ALTKEY_ACTION: "A" | "D"

BWO_VALUE:      "TYPECICS" | "TYPEIMS" | "NO"
DATABASE_FORMAT: "BSON" | "JSON"
EATTR_VALUE:    "NO" | "OPT"
FRLOG_VALUE:    "ALL" | "NONE" | "REDO" | "UNDO"
LOG_VALUE:      "NONE" | "UNDO" | "ALL"
ORG_VALUE:      "INDEXED" | "LINEAR" | "NONINDEXED" | "NUMBERED" | "ZFS"

// ---------------------------------------------------------------------
// DEFINE GENERATIONDATAGROUP (Task 4)
//
// DEFINE GENERATIONDATAGROUP ( gdg_param* )
//
// No DATA(...)/INDEX(...) trailers and no mutually-exclusive-choice
// groups (no space allocation, no ALTKEYS-style pair) -- every parameter
// is freely repeatable, so a plain gdg_param* suffices (unlike Tasks 2-3's
// cluster_seq_*/aix_seq_* DFA state machines).
define_gdg: "DEFINE" "GENERATIONDATAGROUP" "(" gdg_param* ")"

gdg_param: name_param
         | limit_param
         | catalog_param
         | empty_param
         | extended_param
         | gdgorder_param
         | owner_param
         | purge_param
         | scratch_param

limit_param:    "LIMIT" "(" INT ")"
empty_param:    "EMPTY" -> empty_flag
              | "NOEMPTY" -> noempty_flag
extended_param: "EXTENDED" -> extended_flag
              | "NOEXTENDED" -> noextended_flag
gdgorder_param: GDG_ORDER_VALUE
purge_param:    "PURGE" -> purge_flag
              | "NOPURGE" -> nopurge_flag
scratch_param:  "SCRATCH" -> scratch_flag
              | "NOSCRATCH" -> noscratch_flag

GDG_ORDER_VALUE: "FIFO" | "LIFO"

// ---------------------------------------------------------------------
// DEFINE NONVSAM (Task 4)
//
// DEFINE NONVSAM ( nonvsam_param* )
//
// No DATA(...)/INDEX(...) trailers and no mutually-exclusive-choice
// groups. VOLUMES and DEVICETYPES need dedicated rules/terminals (not
// DEFINE CLUSTER's volumes_param) -- see module docstring in
// ast_define_nonvsam.py for why.
define_nonvsam: "DEFINE" "NONVSAM" "(" nonvsam_param* ")"

nonvsam_param: name_param
             | devicetypes_param
             | nonvsam_volumes_param
             | catalog_param
             | collection_param
             | filesequencenumbers_param
             | owner_param
             | recatalog_param
             | retention_param

devicetypes_param: "DEVICETYPES" "(" DEVICE_TYPE+ ")"

nonvsam_volumes_param: "VOLUMES" "(" nonvsam_volume_item+ ")"
nonvsam_volume_item: NAME | INDIRECT_VOLUME_STAR | INDIRECT_VOLUME_SYMBOLIC

collection_param: "COLLECTION" -> collection_flag

filesequencenumbers_param: "FILESEQUENCENUMBERS" "(" INT+ ")"

DEVICE_TYPE: /[A-Z0-9#@$]+/
INDIRECT_VOLUME_STAR: "******"
INDIRECT_VOLUME_SYMBOLIC: /&[A-Z0-9#@$]{1,5}/

// ---------------------------------------------------------------------
// DEFINE PATH (Task 4)
//
// DEFINE PATH ( path_param* )
//
// No DATA(...)/INDEX(...) trailers and no mutually-exclusive-choice
// groups -- reuses catalog_param/model_param/owner_param/recatalog_param/
// retention_param verbatim from Tasks 2-3.
define_path: "DEFINE" "PATH" "(" path_param* ")"

path_param: name_param
          | pathentry_param
          | catalog_param
          | model_param
          | owner_param
          | recatalog_param
          | retention_param
          | update_param

pathentry_param: "PATHENTRY" "(" NAME ")"
update_param:    "UPDATE" -> update_flag
               | "NOUPDATE" -> noupdate_flag

// ---------------------------------------------------------------------
// DELETE (Task 5)
//
// DELETE ( entryname [entryname...] ) delete_param*
//
// entryname list is the one required positional parameter (list/single
// elision applies: a single entry drops its enclosing parens, so both
// `DELETE (A)` and bare `DELETE A` -- the real corpus's common bare-dsname
// form, no trailing type keyword required -- are valid). Max 100 entries
// is a semantic check in the transformer, not a grammar-level limit.
//
// entry_type (ALIAS|ALTERNATEINDEX|CLUSTER|...|VVR) is the one genuine
// "pick one kind" choice in this command -- a single entry can't be both
// CLUSTER and PATH -- so it needs single-occurrence enforcement, same
// rationale as cluster_seq_*/aix_seq_* above. Unlike those, it has no
// second, independently-varying choice dimension to combine with here, so
// a plain two-state sequence (entry_type consumed yet?) suffices -- no
// four-state DFA needed. The six documented ON/OFF toggle pairs
// (ERASE/NOERASE, FORCE/NOFORCE, MASK/NOMASK, PURGE/NOPURGE,
// RECOVERY/NORECOVERY, SCRATCH/NOSCRATCH) are ordinary freely-repeatable
// params -- last-wins-in-a-repeatable-list semantics is an accepted,
// low-risk interpretation for simple booleans, per the plan's ratified
// scoping decision.
delete: "DELETE" delete_entries delete_seq_0

delete_entries: "(" DELETE_ENTRY+ ")" | DELETE_ENTRY

// state: entry_type not yet consumed
delete_seq_0: delete_param delete_seq_0
            | entry_type_param delete_seq_1
            |
// state: entry_type consumed -- only freely-repeatable params remain
delete_seq_1: delete_param delete_seq_1
            |

delete_param: catalog_param
            | erase_param
            | file_param
            | force_param
            | mask_param
            | nodisconnect_param
            | purge_param
            | delete_recovery_param
            | scratch_param

entry_type_param: ENTRY_TYPE_VALUE

force_param: "FORCE" -> force_flag
           | "NOFORCE" -> noforce_flag
mask_param:  "MASK" -> mask_flag
           | "NOMASK" -> nomask_flag
nodisconnect_param: "NODISCONNECT" -> nodisconnect_flag
delete_recovery_param: "RECOVERY" -> delete_recovery_flag
                      | "NORECOVERY" -> delete_norecovery_flag

// Entry names accepted here are broader than the shared NAME/GENERIC_NAME
// terminals: DELETE's MASK filter-key patterns use "**" (matches zero or
// more qualifiers) and "%" (matches a single character within a
// qualifier) in addition to plain names and the single-"*"-qualifier
// generic form -- neither of which the strict Name.parse regex accepts.
// The transformer tries Name.parse() first and falls back to a raw
// Name(text=..., generic=True) for anything Name.parse rejects (i.e. real
// MASK patterns), rather than loosening ast_values.py's shared, stricter
// validation used by every other command.
DELETE_ENTRY: /[A-Z0-9#@$%*]+(\.[A-Z0-9#@$%*]+)*/

ENTRY_TYPE_VALUE: "ALIAS" | "ALTERNATEINDEX" | "CLUSTER" | "GENERATIONDATAGROUP"
                 | "LIBRARYENTRY" | "NONVSAM" | "NVR" | "PAGESPACE" | "PATH"
                 | "TRUENAME" | "USERCATALOG" | "VOLUMEENTRY" | "VVR"

// ---------------------------------------------------------------------
// ALTER (Task 6)
//
// ALTER entryname alter_param*
//
// entryname is the one required positional parameter -- a single Name,
// no list/masking form (unlike DELETE's entries list).
//
// The manual documents exactly one genuine "pick one" choice in ALTER:
// LOCK/UNLOCK vs SUSPEND/RESUME, both of which operate on the same
// underlying "catalog access state" -- a single ALTER can't simultaneously
// lock/unlock AND suspend/resume the same catalog. Modeled as a single
// 4-way choice (catalog_state_choice), pulled out of the freely-repeatable
// param list into a two-state sequence (alter_seq_0/alter_seq_1) exactly
// like DELETE's entry_type_param/delete_seq_0/delete_seq_1 -- one
// choice-of-4, single slot, not the two-independently-coupled-dimensions
// DFA that DEFINE CLUSTER/ALTERNATEINDEX needed. Every other documented
// ON/OFF pair in ALTER (ERASE/NOERASE, EMPTY/NOEMPTY, INHIBIT/UNINHIBIT,
// PURGE/NOPURGE, RECLAIMCA/NORECLAIMCA, REUSE/NOREUSE,
// RLSQUIESCE/RLSENABLE, SCRATCH/NOSCRATCH, UNIQUEKEY/NONUNIQUEKEY,
// UPDATE/NOUPDATE, UPGRADE/NOUPGRADE, WRITECHECK/NOWRITECHECK, FIFO/LIFO,
// ECSHARING/NOECSHARING) is an ordinary freely-repeatable param -- last-
// wins-in-a-repeatable-list semantics is accepted for simple binary
// toggles per the plan's ratified scoping decision.
//
// No STAGE parameter: the design spec explicitly defers it (definition
// not recoverable from the manual excerpt read when the spec was
// written); not added here either.
alter: "ALTER" NAME alter_seq_0

// state: catalog_state_choice not yet consumed
alter_seq_0: alter_param alter_seq_0
           | catalog_state_choice alter_seq_1
           |
// state: catalog_state_choice consumed -- only freely-repeatable params remain
alter_seq_1: alter_param alter_seq_1
           |

catalog_state_choice: "LOCK" -> lock_flag
                     | "UNLOCK" -> unlock_flag
                     | "SUSPEND" -> suspend_flag
                     | "RESUME" -> resume_flag

alter_param: newname_param
           | addvolumes_param
           | removevolumes_param
           | account_param
           | bufferspace_param
           | bufnd_param
           | bufni_param
           | bwo_param
           | catalog_param
           | ccsid_param
           | ecsharing_param
           | empty_param
           | erase_param
           | exceptionexit_param
           | extendedaddressable_param
           | gdgorder_param
           | file_param
           | filedata_param
           | freespace_param
           | alter_frlog_param
           | inhibit_param
           | keys_param
           | limit_param
           | alter_log_param
           | logreplicate_param
           | logstreamid_param
           | managementclass_param
           | nullify_clause
           | owner_param
           | purge_param
           | reclaimca_param
           | recordsize_param
           | reuse_param
           | rls_param
           | rollin_param
           | scratch_param
           | shareoptions_param
           | storageclass_param
           | strno_param
           | retention_param
           | typelinear_param
           | uniquekey_param
           | update_param
           | upgrade_param
           | writecheck_param

newname_param:        "NEWNAME" "(" NAME ")"
addvolumes_param:     "ADDVOLUMES" "(" NAME+ ")"
removevolumes_param:  "REMOVEVOLUMES" "(" NAME+ ")"
bufnd_param:          "BUFND" "(" INT ")"
bufni_param:          "BUFNI" "(" INT ")"
ccsid_param:          "CCSID" "(" INT ")"
ecsharing_param:      "ECSHARING" -> ecsharing_flag
                     | "NOECSHARING" -> noecsharing_flag
extendedaddressable_param: "EXTENDEDADDRESSABLE" -> extendedaddressable_flag
filedata_param:       "FILEDATA" "(" FILEDATA_VALUE ")"
alter_frlog_param:    "FRLOG" "(" ALTER_FRLOG_VALUE ")"
inhibit_param:        "INHIBIT" -> inhibit_flag
                     | "UNINHIBIT" -> uninhibit_flag
alter_log_param:      "LOG" "(" ALTER_LOG_VALUE ")"
reclaimca_param:      "RECLAIMCA" -> reclaimca_flag
                     | "NORECLAIMCA" -> noreclaimca_flag
rollin_param:         "ROLLIN" -> rollin_flag
strno_param:          "STRNO" "(" INT ")"
typelinear_param:     "TYPE" "(" "LINEAR" ")" -> typelinear_flag

FILEDATA_VALUE:     "TEXT" | "BINARY"
ALTER_FRLOG_VALUE:  "NONE" | "REDO"
ALTER_LOG_VALUE:    "NONE" | "UNDO" | "ALL" | "REDO"

// NULLIFY(...) sub-block: a nested parenthesized group, not a top-level
// command-wide mutual-exclusivity concern. All 9 sub-options are
// independently settable -- a single NULLIFY can plausibly nullify
// several attributes at once, so (unlike catalog_state_choice above) this
// is NOT a "pick one" choice.
nullify_clause: "NULLIFY" "(" nullify_param* ")"

nullify_param: nullify_authorization_param
             | nullify_bwo_param
             | nullify_code_param
             | nullify_exceptionexit_param
             | nullify_log_param
             | nullify_logstreamid_param
             | nullify_managementclass_param
             | nullify_owner_param
             | nullify_retention_param

nullify_authorization_param:   "AUTHORIZATION" "(" NULLIFY_AUTH_VALUE ")"
nullify_bwo_param:             "BWO"
nullify_code_param:            "CODE"
nullify_exceptionexit_param:   "EXCEPTIONEXIT"
nullify_log_param:             "LOG"
nullify_logstreamid_param:     "LOGSTREAMID"
nullify_managementclass_param: "MANAGEMENTCLASS"
nullify_owner_param:           "OWNER"
nullify_retention_param:       "RETENTION"

NULLIFY_AUTH_VALUE: "MODULE" | "STRING"

// ---------------------------------------------------------------------
// REPRO (Task 7), including ENCIPHER(...)/DECIPHER(...)
//
// REPRO { INFILE(ddname) | INDATASET(entryname) } { OUTFILE(ddname) |
//   OUTDATASET(entryname) } repro_param*
//
// No enclosing parens around the whole parameter list (like ALTER, unlike
// DEFINE CLUSTER/ALTERNATEINDEX) -- INFILE/INDATASET and OUTFILE/OUTDATASET
// are the two REQUIRED "pick one" choices (a source and a target, each
// exactly one of two forms), and the design spec documents six more
// OPTIONAL "pick one" groups: ENTRIES/LEVEL, the 4-way RangeStart
// (FROMKEY/FROMADDRESS/FROMNUMBER/SKIP), the 4-way RangeEnd
// (TOKEY/TOADDRESS/TONUMBER/COUNT), ENCIPHER/DECIPHER, INSERTSHIFT/
// INSERTALL, and SKIPDBCSCHECK/NODBCSCHECK.
//
// All ~15 ordinary params AND the individual members of the eight "pick
// one" groups above are siblings in ONE flat, freely-repeatable
// repro_param list -- Lark's "*" doesn't care about relative order, so
// real-world reorderings (e.g. OUTFILE before INFILE) parse structurally.
// "At most one member of a mutually-exclusive group" (and "at least one
// of INFILE/INDATASET, and at least one of OUTFILE/OUTDATASET, is
// required") is NOT a grammar-level constraint here -- it's enforced
// post-parse by ComprehensiveIdcamsTransformer.repro(), which raises
// ValueError on a violation. This mirrors DEFINE CLUSTER's
// DATABASE(...)/KEYNAME(...) pattern (parser_comprehensive.py's
// define_cluster): the grammar accepts broadly, the transformer validates
// semantically. A combinatorial grammar-level DFA across all eight
// uncoupled groups would need 2^8 states for no semantic benefit.
repro: "REPRO" repro_param*

repro_param: infile_param
           | indataset_param
           | outfile_param
           | outdataset_param
           | entries_param
           | level_param
           | fromkey_param
           | fromaddress_param
           | fromnumber_param
           | skip_param
           | tokey_param
           | toaddress_param
           | tonumber_param
           | count_param
           | encipher_clause
           | decipher_clause
           | insertshift_param
           | insertall_param
           | skipdbcscheck_param
           | nodbcscheck_param
           | repro_cimode_param
           | repro_dbcs_param
           | errorlimit_param
           | file_param
           | mergecat_param
           | messagelevel_param
           | replace_param
           | reuse_param
           | volumeentries_param
           | rlssource_param
           | rlstarget_param

infile_param:     "INFILE" "(" NAME ")"
indataset_param:  "INDATASET" "(" NAME ")"
outfile_param:    "OUTFILE" "(" NAME ")"
outdataset_param: "OUTDATASET" "(" NAME ")"

entries_param: "ENTRIES" "(" NAME+ ")"
level_param:   "LEVEL" "(" NAME ")"

fromkey_param:     "FROMKEY" "(" value ")"
fromaddress_param: "FROMADDRESS" "(" value ")"
fromnumber_param:  "FROMNUMBER" "(" value ")"
skip_param:        "SKIP" "(" value ")"

tokey_param:     "TOKEY" "(" value ")"
toaddress_param: "TOADDRESS" "(" value ")"
tonumber_param:  "TONUMBER" "(" value ")"
count_param:     "COUNT" "(" value ")"

int_pair: "(" INT INT ")"

insertshift_param: "INSERTSHIFT" "(" int_pair+ ")"
insertall_param:   "INSERTALL" -> insertall_flag

skipdbcscheck_param: "SKIPDBCSCHECK" "(" int_pair+ ")"
nodbcscheck_param:   "NODBCSCHECK" -> nodbcscheck_flag

repro_cimode_param: "CIMODE" -> repro_cimode_flag
                   | "NOCIMODE" -> repro_nocimode_flag
repro_dbcs_param:   "DBCS" -> repro_dbcs_flag
errorlimit_param:   "ERRORLIMIT" "(" INT ")"
mergecat_param:      "MERGECAT" -> mergecat_flag
                    | "NOMERGECAT" -> nomergecat_flag
messagelevel_param: "MESSAGELEVEL" "(" MESSAGELEVEL_VALUE ")"
replace_param:       "REPLACE" -> replace_flag
                    | "NOREPLACE" -> noreplace_flag
volumeentries_param: "VOLUMEENTRIES" "(" NAME ")"
rlssource_param: "RLSSOURCE" "(" RLS_STATE_VALUE ")"
rlstarget_param: "RLSTARGET" "(" RLS_STATE_VALUE ")"

MESSAGELEVEL_VALUE: "ALL" | "SHORT"
RLS_STATE_VALUE:    "NO" | "YES" | "QUIESCE"

// ENCIPHER(...) -- CipherSpec. EXTERNALKEYNAME/INTERNALKEYNAME/PRIVATEKEY
// is CipherSpec's own genuine "pick one key-management mode" choice
// (required -- exactly one); like the top-level groups above, this is now
// a flat freely-repeatable cipher_param list, with the "exactly one key
// mode" constraint enforced by the transformer's encipher_clause() method,
// not the grammar. CIPHERUNIT, DATAKEYFILE, DATAKEYVALUE, SHIPKEYNAMES,
// STOREDATAKEY/NOSTOREDATAKEY, STOREKEYNAME, and USERDATA are ordinary
// freely-repeatable cipher_param entries.
encipher_clause: "ENCIPHER" "(" cipher_param* ")"

cipher_param: cipherunit_param
            | cipher_datakeyfile_param
            | cipher_datakeyvalue_param
            | shipkeynames_param
            | storedatakey_param
            | storekeyname_param
            | userdata_param
            | externalkeyname_choice
            | internalkeyname_choice
            | privatekey_choice

externalkeyname_choice: "EXTERNALKEYNAME" "(" NAME ")"
internalkeyname_choice: "INTERNALKEYNAME" "(" NAME ")"
privatekey_choice:      "PRIVATEKEY"

cipherunit_param:         "CIPHERUNIT" "(" INT ")"
cipher_datakeyfile_param:  "DATAKEYFILE" "(" NAME ")" -> cipher_datakeyfile
cipher_datakeyvalue_param: "DATAKEYVALUE" "(" (NAME | QUOTED_STRING) ")" -> cipher_datakeyvalue
shipkeynames_param:       "SHIPKEYNAMES" "(" NAME+ ")"
storedatakey_param:        "STOREDATAKEY" -> storedatakey_flag
                          | "NOSTOREDATAKEY" -> nostoredatakey_flag
storekeyname_param:       "STOREKEYNAME" "(" NAME ")"
userdata_param:           "USERDATA" "(" (NAME | QUOTED_STRING) ")"

// DECIPHER(...) -- DecipherSpec. DATAKEYFILE/DATAKEYVALUE/SYSTEMKEY is
// DecipherSpec's own genuine "pick one key-management mode" choice
// (required -- exactly one), same rationale/pattern as CipherSpec's key
// choice above -- flat grammar, transformer-enforced. SYSTEMDATAKEY/
// SYSTEMKEYNAME are ordinary freely-repeatable decipher_param entries.
decipher_clause: "DECIPHER" "(" decipher_param* ")"

decipher_param: systemdatakey_param
              | systemkeyname_param
              | dk_datakeyfile_choice
              | dk_datakeyvalue_choice
              | dk_systemkey_choice

dk_datakeyfile_choice:  "DATAKEYFILE" "(" NAME ")"
dk_datakeyvalue_choice: "DATAKEYVALUE" "(" (NAME | QUOTED_STRING) ")"
dk_systemkey_choice:    "SYSTEMKEY"

systemdatakey_param: "SYSTEMDATAKEY" "(" (NAME | QUOTED_STRING) ")"
systemkeyname_param: "SYSTEMKEYNAME" "(" NAME ")"

// ---------------------------------------------------------------------
// PRINT (Task 8)
//
// PRINT { INFILE(ddname) | INDATASET(entryname) } print_param*
//
// Same flat-grammar/transformer-validated pattern as REPRO above:
// INFILE/INDATASET is PRINT's one required "pick one" choice; CHARACTER/
// DUMP/HEX, RangeStart (FROMKEY/FROMADDRESS/FROMNUMBER/SKIP), RangeEnd
// (TOKEY/TOADDRESS/TONUMBER/COUNT), INSERTSHIFT/INSERTALL, and
// SKIPDBCSCHECK/NODBCSCHECK are optional "pick one" groups, all enforced
// post-parse by ComprehensiveIdcamsTransformer.print_(), not the grammar.
//
// PRINT's RangeStart/RangeEnd, INSERTSHIFT/INSERTALL, SKIPDBCSCHECK/
// NODBCSCHECK, CIMODE/NOCIMODE, DBCS, FILE, and RLSSOURCE are IDENTICAL in
// shape to REPRO's -- fromkey_param/fromaddress_param/fromnumber_param/
// skip_param/tokey_param/toaddress_param/tonumber_param/count_param/
// insertshift_param/insertall_param/skipdbcscheck_param/nodbcscheck_param/
// repro_cimode_param/repro_dbcs_param/file_param/rlssource_param are
// ordinary top-level grammar rules (not nested inside REPRO's own rule),
// so print_param references them directly instead of redefining them --
// the resulting RangeStart/RangeEnd dataclasses (ast_repro.py) are shared
// verbatim per the plan's interface contract for this task.
print: "PRINT" print_param*

print_param: infile_param
           | indataset_param
           | outfile_param
           | print_format_param
           | repro_cimode_param
           | repro_dbcs_param
           | fromkey_param
           | fromaddress_param
           | fromnumber_param
           | skip_param
           | tokey_param
           | toaddress_param
           | tonumber_param
           | count_param
           | insertshift_param
           | insertall_param
           | skipdbcscheck_param
           | nodbcscheck_param
           | rlssource_param

print_format_param: "CHARACTER" -> print_character_flag
                   | "DUMP"      -> print_dump_flag
                   | "HEX"       -> print_hex_flag

// ---------------------------------------------------------------------
// LISTCAT (Task 8)
//
// LISTCAT listcat_param*
//
// Every LISTCAT parameter is optional (the "no operand" case lists
// everything in the catalog). ENTRIES/LEVEL is LISTCAT's sole
// mutual-exclusivity "pick one" group, reusing REPRO's entries_param/
// level_param rules verbatim, enforced post-parse like PRINT/REPRO above.
// The five detail-level keywords (NAME/HISTORY/VOLUME/ALLOCATION/ALL) are
// likewise an optional "pick one" group (listcat_detail_param), also
// transformer-enforced.
//
// entry_types (ALIAS/ALTERNATEINDEX/CLUSTER/DATA/GENERATIONDATAGROUP/
// INDEX/NONVSAM/PAGESPACE/PATH/USERCATALOG) is explicitly NOT a choice
// group -- the manual allows combining multiple entry-type filters in one
// LISTCAT (e.g. "LISTCAT ALIAS CLUSTER"), so listcat_entrytype_param is an
// ordinary freely-repeatable listcat_param alternative, and every
// occurrence is collected into the entry_types tuple with no
// single-occurrence enforcement.
//
// CATALOG, VOLUMEENTRIES, FILE, and OUTFILE reuse REPRO's existing
// catalog_param/volumeentries_param/file_param/outfile_param rules, same
// rationale as PRINT's reuse above.
//
// CDILVL/NOCDILVL: the manual documents CDILVL as meaningful only
// alongside LEVEL, but that coupling is NOT grammar-enforced here -- it's
// accepted standalone and deferred to a later semantic/execution layer,
// consistent with this module's parsing-only scope (see the test file's
// module docstring for the explicit decision).
listcat: "LISTCAT" listcat_param*

listcat_param: listcat_entrytype_param
             | libraryentries_param
             | volumeentries_param
             | catalog_param
             | creation_param
             | expiration_param
             | entries_param
             | level_param
             | listcat_cdilvl_param
             | listcat_prefix_param
             | listcat_detail_param
             | file_param
             | library_param
             | outfile_param

listcat_entrytype_param: LISTCAT_ENTRYTYPE_VALUE

LISTCAT_ENTRYTYPE_VALUE: "ALIAS" | "ALTERNATEINDEX" | "CLUSTER" | "DATA"
                        | "GENERATIONDATAGROUP" | "INDEX" | "NONVSAM"
                        | "PAGESPACE" | "PATH" | "USERCATALOG"

libraryentries_param: "LIBRARYENTRIES" "(" NAME ")"
creation_param:       "CREATION" "(" INT ")"
expiration_param:     "EXPIRATION" "(" INT ")"

listcat_cdilvl_param: "CDILVL" -> cdilvl_flag
                     | "NOCDILVL" -> nocdilvl_flag
listcat_prefix_param: "PREFIX" -> prefix_flag
                     | "NOPREFIX" -> noprefix_flag

listcat_detail_param: LISTCAT_DETAIL_VALUE

// Explicit low priority (below the default 0): "VOLUME" and "ALL" are
// prefixes of other LISTCAT keywords assembled from separate tokens
// (VOLUMEENTRIES = "VOLUME"+"ENTRIES", ALLOCATION contains "ALL" as a
// prefix too) -- without this, the earley dynamic lexer's ambiguity
// resolution can pick the split ("VOLUME" detail + "ENTRIES(...)") over
// the intended single VOLUMEENTRIES(...) keyword-with-argument parse.
// Longest-alternative-first within the terminal itself (ALLOCATION before
// ALL) additionally guards against ALLOCATION being misread as ALL.
LISTCAT_DETAIL_VALUE.-1: "ALLOCATION" | "HISTORY" | "VOLUME" | "NAME" | "ALL"

library_param: "LIBRARY" "(" NAME ")"

// ---------------------------------------------------------------------
// EXPORT (Task 9)
//
// EXPORT entryname export_param*
//
// entryname is the one required positional parameter (a single Name, same
// shape as ALTER's). Three genuine "pick one" choice groups, all flat-
// grammar/transformer-enforced per the plan's ratified pattern (see
// ComprehensiveIdcamsTransformer.export()): OUTFILE/OUTDATASET (required,
// exactly one), CIMODE/RECORDMODE (optional, at most one -- which
// processing mode), and TEMPORARY/PERMANENT (optional, at most one --
// which export kind). ERASE/NOERASE, INHIBITSOURCE/NOINHIBITSOURCE,
// INHIBITTARGET/NOINHIBITTARGET, and PURGE/NOPURGE are ordinary simple
// ON/OFF toggle pairs, per the plan's ratified scope for simple booleans.
export: "EXPORT" NAME export_param*

export_param: outfile_param
            | outdataset_param
            | export_mode_param
            | erase_param
            | infile_param
            | inhibitsource_param
            | inhibittarget_param
            | purge_param
            | export_kind_param
            | rlssource_param

export_mode_param: "CIMODE" -> export_cimode_flag
                  | "RECORDMODE" -> export_recordmode_flag

inhibitsource_param: "INHIBITSOURCE" -> inhibitsource_flag
                    | "NOINHIBITSOURCE" -> noinhibitsource_flag
inhibittarget_param: "INHIBITTARGET" -> inhibittarget_flag
                    | "NOINHIBITTARGET" -> noinhibittarget_flag

export_kind_param: "TEMPORARY" -> export_temporary_flag
                  | "PERMANENT" -> export_permanent_flag

// ---------------------------------------------------------------------
// IMPORT (Task 9)
//
// IMPORT import_param*
//
// Two genuine required "pick one" choice groups, both flat-grammar/
// transformer-enforced (ComprehensiveIdcamsTransformer.import_cmd()):
// INFILE/INDATASET and OUTFILE/OUTDATASET. ALIAS/NOALIAS, ERASE/NOERASE,
// LOCK/UNLOCK, PURGE/NOPURGE, and SAVRAC/NOSAVRAC are ordinary simple
// ON/OFF toggle pairs. LOCK/UNLOCK deliberately reuses ALTER's
// catalog_state_choice aliases (lock_flag/unlock_flag) verbatim -- same
// ("lock", bool) shape IMPORT's own `lock` field needs, so no new
// transformer callback is required for it.
//
// OBJECTS(...) is a REPEATABLE list of nested groups (import_object),
// not a mutual-exclusivity choice -- each group has a required positional
// entryname followed by independently-optional FILE/MANAGEMENTCLASS/
// NEWNAME/STORAGECLASS/VOLUMES sub-params, reusing file_param/
// managementclass_param/newname_param/storageclass_param/volumes_param
// verbatim from earlier tasks.
//
// Grammar rule (and its transformer callback) is named `import_cmd`, not
// `import` -- a Transformer method literally named `import` would be a
// Python syntax error (the dataclass `Import` itself is safe to name,
// only the statement keyword is reserved).
import_cmd: "IMPORT" import_param*

import_param: infile_param
            | indataset_param
            | outfile_param
            | outdataset_param
            | alias_param
            | erase_param
            | intoempty_param
            | import_lock_param
            | objects_param
            | purge_param
            | savrac_param
            | catalog_param
            | rlstarget_param

alias_param: "ALIAS" -> alias_flag
           | "NOALIAS" -> noalias_flag
intoempty_param: "INTOEMPTY" -> intoempty_flag
import_lock_param: "LOCK" -> lock_flag
                  | "UNLOCK" -> unlock_flag
savrac_param: "SAVRAC" -> savrac_flag
            | "NOSAVRAC" -> nosavrac_flag

objects_param: "OBJECTS" "(" import_object+ ")"
import_object: "(" NAME import_object_param* ")"
import_object_param: file_param
                    | managementclass_param
                    | newname_param
                    | storageclass_param
                    | volumes_param

// ---------------------------------------------------------------------
// VERIFY (Task 10)
//
// VERIFY verify_param*
//
// The lightest command in the comprehensive-grammar plan. One genuine
// required "pick one" choice group, flat-grammar/transformer-enforced
// (ComprehensiveIdcamsTransformer.verify()): FILE/DATASET. RECOVER is an
// ordinary bare flag.
verify: "VERIFY" verify_param*

verify_param: file_param
            | verify_dataset_param
            | verify_recover_param

verify_dataset_param: "DATASET" "(" NAME ")"
verify_recover_param: "RECOVER" -> verify_recover_flag

// ---------------------------------------------------------------------
// BLDINDEX (Task 10)
//
// BLDINDEX bldindex_param*
//
// Three genuine "pick one" choice groups, all flat-grammar/transformer-
// enforced (ComprehensiveIdcamsTransformer.bldindex()): INFILE/INDATASET
// (required, exactly one; reuses infile_param/indataset_param verbatim
// from REPRO/IMPORT), OUTFILE/OUTDATASET (required, exactly one -- but
// unlike every other OUTFILE/OUTDATASET in this grammar, BLDINDEX's own
// versions each accept a LIST of 1+ ddnames/entrynames, e.g. OUTFILE(A B),
// to build multiple alternate indexes for the same base cluster in one
// invocation -- hence the dedicated bldindex_outfiles_param/
// bldindex_outdatasets_param rules below rather than reusing outfile_param/
// outdataset_param), EXTERNALSORT/INTERNALSORT (optional, at most one --
// which sort strategy), and SORTCALL/NOSORTCALL (optional, at most one --
// which sort mechanism). SORTDEVICETYPE, SORTFILENUMBER, SORTMESSAGEDD,
// SORTMESSAGELEVEL, WORKFILES, and CATALOG are ordinary single-occurrence
// (or, for WORKFILES, plain list) params -- no mutual-exclusivity machinery.
bldindex: "BLDINDEX" bldindex_param*

bldindex_param: infile_param
              | indataset_param
              | bldindex_outfiles_param
              | bldindex_outdatasets_param
              | bldindex_sort_kind_param
              | bldindex_sortcall_param
              | sortdevicetype_param
              | sortfilenumber_param
              | sortmessagedd_param
              | sortmessagelevel_param
              | workfiles_param
              | catalog_param

bldindex_outfiles_param:    "OUTFILE" "(" NAME+ ")"
bldindex_outdatasets_param: "OUTDATASET" "(" NAME+ ")"

bldindex_sort_kind_param: "EXTERNALSORT" -> externalsort_flag
                        | "INTERNALSORT" -> internalsort_flag

bldindex_sortcall_param: "SORTCALL" -> sortcall_flag
                       | "NOSORTCALL" -> nosortcall_flag

sortdevicetype_param: "SORTDEVICETYPE" "(" DEVICE_TYPE ")"
sortfilenumber_param: "SORTFILENUMBER" "(" INT ")"
sortmessagedd_param:  "SORTMESSAGEDD" "(" NAME ")"
sortmessagelevel_param: "SORTMESSAGELEVEL" "(" SORT_MESSAGE_LEVEL_VALUE ")"
workfiles_param:      "WORKFILES" "(" NAME NAME ")"

SORT_MESSAGE_LEVEL_VALUE: "ALL" | "CRITICAL" | "NONE"

// ---------------------------------------------------------------------
NAME:          /[A-Z#@$][A-Z0-9#@$]*(\.[A-Z#@$][A-Z0-9#@$]*)*/
GENERIC_NAME:  /[A-Z#@$][A-Z0-9#@$]*(\.[A-Z#@$][A-Z0-9#@$]*)*\.\*(\.[A-Z#@$][A-Z0-9#@$]*)?/
QUOTED_STRING: /'([^']|'')*'/
HEX_LITERAL:   /X'[0-9A-Fa-f]+'/
BIN_LITERAL:   /B'[01]+'/
INT:           /[0-9]+/

// Whitespace, "-" continuation (whitespace-equivalent), semicolon
// terminator (rest of physical line becomes a comment), and /* */
// comments are all ignorable. "+" continuation is handled by
// preprocess.join_plus_continuations() *before* this grammar ever sees
// the text, not here.
%ignore /[ \t\r\n]+/
%ignore /-[ \t]*(?=\r?\n)/
%ignore /;[^\r\n]*/
%ignore /\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\//
