// jackal/jackal/idcams/grammar/ams.lark
// Shared terminals and lexical rules for the comprehensive IDCAMS grammar.
// Command-specific rules are added here by later tasks (Tasks 2-11), each
// contributing its own `command:` alternative and rule definitions.

start: command+

command: modal_command | set_command | define_cluster | define_alternateindex  // set_command is
                                       // placeholder scaffolding (like
                                       // modal_command) so start.lark is
                                       // parseable standalone during Task 1.

// Not prefixed with "?": as the top-level `start` rule in standalone
// lexical tests, a "?"-inlined single-child rule collapses to a bare
// Token with no `.children`, which the tests need. Non-standalone uses
// (nested inside other rules added by later tasks) still see this as an
// ordinary one-child Tree, which is equally usable.
value: NAME | GENERIC_NAME | QUOTED_STRING | HEX_LITERAL | BIN_LITERAL | INT

modal_command: "CANCEL"   // minimal placeholder so start.lark is parseable
                          // standalone during Task 1; replaced/extended by
                          // Task 11's real modal_command rule.

set_command: "SET" NAME "=" INT  // minimal placeholder covering IDCAMS's
                                  // SET MAXCC=n idiom, used here only to
                                  // exercise the semicolon-terminator and
                                  // inline-comment lexical rules standalone
                                  // during Task 1.

// ---------------------------------------------------------------------
// DEFINE CLUSTER (Task 2)
//
// DEFINE CLUSTER ( cluster_param* ) [DATA ( data_param* )] [INDEX ( index_param* )]
//
// cluster_param covers the ~50 CLUSTER-level parameters. DATA(...) and
// INDEX(...) are separate trailer clauses (siblings of the CLUSTER
// parens, not nested inside them) each with their OWN parameter rule
// (data_param / index_param) -- deliberately NOT shared, since INDEX(...)
// rejects SPANNED/NONSPANNED, ERASE/NOERASE, BUFFERSPACE, FREESPACE,
// KEYS, RECORDSIZE, and SPEED/RECOVERY, which are meaningless for an
// index component per the IDCAMS manual.
//
// CYLINDERS|KILOBYTES|MEGABYTES|RECORDS|TRACKS is one rule (space_choice)
// with five alternatives -- a genuine mutually-exclusive choice, not five
// independently-optional rules that could all match at once. Likewise
// INDEXED|LINEAR|NONINDEXED|NUMBERED|ZFS (organization_param).
//
// Real DEFINE CLUSTER/DATA/INDEX syntax lets these mutually-exclusive
// choices appear in any position relative to the other (freely repeatable)
// parameters -- so `cluster_param*` alone can't enforce "at most one
// space_choice" (Lark/Earley repetition has no built-in cardinality limit
// across alternatives). Instead the sequences below are small right-
// recursive state machines: `cluster_seq_*` tracks "has a space_choice
// been consumed yet?" x "has an organization choice been consumed yet?"
// (four states); `data_seq_*`/`index_seq_*` track only the space_choice
// dimension (DATA/INDEX have no organization choice). Each state only
// offers a transition into "that choice consumed" once, so a second
// CYLINDERS/TRACKS/etc. (or a second INDEXED/LINEAR/etc.) on the same
// command has no valid parse -- a genuine LarkError, not silent last-wins.
define_cluster: "DEFINE" "CLUSTER" "(" cluster_seq_00 ")" component_clause*

component_clause: data_clause | index_clause
data_clause:  "DATA"  "(" data_seq_0 ")"
index_clause: "INDEX" "(" index_seq_0 ")"

// state: neither space_choice nor organization_param consumed yet
cluster_seq_00: cluster_param cluster_seq_00
              | space_choice cluster_seq_10
              | organization_param cluster_seq_01
              |
// state: space_choice consumed, organization_param not yet
cluster_seq_10: cluster_param cluster_seq_10
              | organization_param cluster_seq_11
              |
// state: organization_param consumed, space_choice not yet
cluster_seq_01: cluster_param cluster_seq_01
              | space_choice cluster_seq_11
              |
// state: both consumed -- only the freely-repeatable params remain
cluster_seq_11: cluster_param cluster_seq_11
              |

// DATA(...)/INDEX(...) only track the space_choice dimension (no
// organization choice at the component level).
data_seq_0: data_param data_seq_0
          | space_choice data_seq_1
          |
data_seq_1: data_param data_seq_1
          |

index_seq_0: index_param index_seq_0
           | space_choice index_seq_1
           |
index_seq_1: index_param index_seq_1
           |

cluster_param: name_param
             | volumes_param
             | account_param
             | bufferspace_param
             | bwo_param
             | catalog_param
             | cisz_param
             | database_format_param
             | keyname_param
             | keynameu_param
             | dataclass_param
             | eattr_param
             | erase_param
             | exceptionexit_param
             | file_param
             | freespace_param
             | frlog_param
             | keylabel_param
             | keys_param
             | log_param
             | logreplicate_param
             | logstreamid_param
             | managementclass_param
             | model_param
             | owner_param
             | recatalog_param
             | recordsize_param
             | reuse_param
             | rls_param
             | shareoptions_param
             | spanned_param
             | speed_param
             | storageclass_param
             | retention_param
             | writecheck_param
             | obsolete_ignored_param

// DataComponent: CLUSTER-level params minus everything that only makes
// sense at the cluster/catalog level (ACCOUNT, BWO, CATALOG, DATABASE,
// DATACLASS, EATTR, FRLOG, organization, KEYLABEL, LOG*, MANAGEMENTCLASS,
// RECATALOG, RLS*, STORAGECLASS, retention).
data_param: name_param
          | volumes_param
          | bufferspace_param
          | cisz_param
          | erase_param
          | exceptionexit_param
          | file_param
          | freespace_param
          | keys_param
          | model_param
          | owner_param
          | recordsize_param
          | reuse_param
          | shareoptions_param
          | spanned_param
          | speed_param
          | writecheck_param
          | obsolete_ignored_param

// IndexComponent: strict subset of data_param -- no SPANNED/NONSPANNED,
// ERASE/NOERASE, BUFFERSPACE, FREESPACE, KEYS, RECORDSIZE, SPEED/RECOVERY.
index_param: name_param
           | volumes_param
           | cisz_param
           | exceptionexit_param
           | file_param
           | model_param
           | owner_param
           | reuse_param
           | shareoptions_param
           | writecheck_param
           | obsolete_ignored_param

name_param: "NAME" "(" NAME ")"

cylinders_alloc: "CYLINDERS" "(" INT INT? ")"
kilobytes_alloc: "KILOBYTES" "(" INT INT? ")"
megabytes_alloc: "MEGABYTES" "(" INT INT? ")"
records_alloc:   "RECORDS"   "(" INT INT? ")"
tracks_alloc:    "TRACKS"    "(" INT INT? ")"
space_choice: cylinders_alloc | kilobytes_alloc | megabytes_alloc | records_alloc | tracks_alloc

volumes_param: "VOLUMES" "(" NAME+ ")"

account_param:       "ACCOUNT" "(" NAME ")"
bufferspace_param:   "BUFFERSPACE" "(" INT ")"
bwo_param:           "BWO" "(" BWO_VALUE ")"
catalog_param:       "CATALOG" "(" NAME ")"
cisz_param:          "CONTROLINTERVALSIZE" "(" INT ")"
database_format_param: "DATABASE" "(" DATABASE_FORMAT ")"
keyname_param:       "KEYNAME" "(" NAME ")"
keynameu_param:      "KEYNAMEU" "(" NAME ")"
dataclass_param:     "DATACLASS" "(" NAME ")"
eattr_param:         "EATTR" "(" EATTR_VALUE ")"
erase_param:         "ERASE" -> erase_flag
                    | "NOERASE" -> noerase_flag
exceptionexit_param: "EXCEPTIONEXIT" "(" NAME ")"
file_param:          "FILE" "(" NAME ")"
freespace_param:     "FREESPACE" "(" INT INT ")"
frlog_param:         "FRLOG" "(" FRLOG_VALUE ")"
organization_param:  ORG_VALUE
keylabel_param:      "KEYLABEL" "(" NAME ")"
keys_param:          "KEYS" "(" INT INT ")"
log_param:           "LOG" "(" LOG_VALUE ")"
logreplicate_param:  "LOGREPLICATE" -> logreplicate_flag
                    | "NOLOGREPLICATE" -> nologreplicate_flag
logstreamid_param:   "LOGSTREAMID" "(" NAME ")"
managementclass_param: "MANAGEMENTCLASS" "(" NAME ")"
model_param:         "MODEL" "(" NAME NAME? ")"
owner_param:         "OWNER" "(" NAME ")"
recatalog_param:     "RECATALOG" -> recatalog_flag
                    | "NORECATALOG" -> norecatalog_flag
recordsize_param:    "RECORDSIZE" "(" INT INT ")"
reuse_param:         "REUSE" -> reuse_flag
                    | "NOREUSE" -> noreuse_flag
rls_param:           "RLSQUIESCE" -> rlsquiesce_flag
                    | "RLSENABLE" -> rlsenable_flag
shareoptions_param:  "SHAREOPTIONS" "(" INT INT? ")"
spanned_param:       "SPANNED" -> spanned_flag
                    | "NONSPANNED" -> nonspanned_flag
speed_param:         "SPEED" -> speed_flag
                    | "RECOVERY" -> recovery_flag
storageclass_param:  "STORAGECLASS" "(" NAME ")"
retention_param:     "TO" "(" INT ")" -> to_retention
                    | "FOR" "(" INT ")" -> for_retention
writecheck_param:    "WRITECHECK" -> writecheck_flag
                    | "NOWRITECHECK" -> nowritecheck_flag

// Obsolete parameters that real (old) JCL may still contain: accepted so
// parsing does not fail, but carry no semantic value on DefineCluster
// (unlike DefineAlternateIndex, which has dedicated *_ignored fields).
obsolete_ignored_param: "IMBED" -> obsolete_ignored
                       | "NOIMBED" -> obsolete_ignored
                       | "KEYRANGES" "(" INT+ ")" -> obsolete_ignored
                       | "KEYRANGE" "(" INT+ ")" -> obsolete_ignored
                       | "ORDERED" -> obsolete_ignored
                       | "UNORDERED" -> obsolete_ignored
                       | "REPLICATE" -> obsolete_ignored
                       | "NOREPLICATE" -> obsolete_ignored

// ---------------------------------------------------------------------
// DEFINE ALTERNATEINDEX (Task 3)
//
// DEFINE ALTERNATEINDEX ( aix_param* ) [DATA ( aixdata_param* )] [INDEX ( aixindex_param* )]
//
// Two independent mutually-exclusive choices can appear at the AIX
// (command) level -- the space_choice (CYLINDERS|KILOBYTES|...,
// shared with DEFINE CLUSTER) and ALTKEYS|ALTKEYSU (RLS VSAMDB
// alternate-key-name lists, "already UTF-8" vs not). Same rationale as
// cluster_seq_*/data_seq_*/index_seq_* above: aix_param* alone can't
// enforce "at most one of these", so aix_seq_* is a small right-
// recursive state machine tracking both dimensions (space_choice
// consumed? x altkey_choice consumed?) -- four states, same shape as
// cluster_seq_00/10/01/11. aixdata_seq_*/aixindex_seq_* only track the
// space_choice dimension, mirroring data_seq_*/index_seq_*.
define_alternateindex: "DEFINE" "ALTERNATEINDEX" "(" aix_seq_00 ")" aix_component_clause*

aix_component_clause: aixdata_clause | aixindex_clause
aixdata_clause:  "DATA"  "(" aixdata_seq_0 ")"
aixindex_clause: "INDEX" "(" aixindex_seq_0 ")"

altkey_choice: altkeys_param | altkeysu_param

// state: neither space_choice nor altkey_choice consumed yet
aix_seq_00: aix_param aix_seq_00
          | space_choice aix_seq_10
          | altkey_choice aix_seq_01
          |
// state: space_choice consumed, altkey_choice not yet
aix_seq_10: aix_param aix_seq_10
          | altkey_choice aix_seq_11
          |
// state: altkey_choice consumed, space_choice not yet
aix_seq_01: aix_param aix_seq_01
          | space_choice aix_seq_11
          |
// state: both consumed -- only the freely-repeatable params remain
aix_seq_11: aix_param aix_seq_11
          |

aixdata_seq_0: aixdata_param aixdata_seq_0
             | space_choice aixdata_seq_1
             |
aixdata_seq_1: aixdata_param aixdata_seq_1
             |

aixindex_seq_0: aixindex_param aixindex_seq_0
              | space_choice aixindex_seq_1
              |
aixindex_seq_1: aixindex_param aixindex_seq_1
              |

aix_param: name_param
         | relate_param
         | volumes_param
         | bufferspace_param
         | catalog_param
         | cisz_param
         | dataclass_param
         | erase_param
         | exceptionexit_param
         | file_param
         | freespace_param
         | imbed_param
         | keyranges_param
         | keys_param
         | model_param
         | order_param
         | owner_param
         | recatalog_param
         | recordsize_param
         | replicate_param
         | reuse_param
         | shareoptions_param
         | speed_param
         | retention_param
         | uniquekey_param
         | upgrade_param
         | writecheck_param

// AixDataComponent: same shape as DataComponent minus SPANNED/NONSPANNED
// (not valid for an AIX component at all per the manual), plus
// ATTEMPTS/AUTHORIZATION/CODE/UNIQUEKEY (AIX-specific).
aixdata_param: name_param
             | volumes_param
             | attempts_param
             | authorization_param
             | bufferspace_param
             | code_param
             | cisz_param
             | erase_param
             | exceptionexit_param
             | file_param
             | freespace_param
             | keys_param
             | model_param
             | owner_param
             | recordsize_param
             | reuse_param
             | shareoptions_param
             | speed_param
             | uniquekey_param
             | writecheck_param

// AixIndexComponent: strict subset of aixdata_param -- no BUFFERSPACE,
// ERASE/NOERASE, FREESPACE, KEYS, RECORDSIZE, SPEED/RECOVERY, UNIQUEKEY.
aixindex_param: name_param
              | volumes_param
              | attempts_param
              | authorization_param
              | code_param
              | cisz_param
              | exceptionexit_param
              | file_param
              | model_param
              | owner_param
              | reuse_param
              | shareoptions_param
              | writecheck_param

relate_param: "RELATE" "(" NAME ")"

altkey_entry: NAME ALTKEY_ACTION
altkeys_param:  "ALTKEYS"  "(" altkey_entry+ ")"
altkeysu_param: "ALTKEYSU" "(" altkey_entry+ ")"

attempts_param:     "ATTEMPTS" "(" INT ")"
authorization_param: "AUTHORIZATION" "(" NAME QUOTED_STRING? ")"
code_param:          "CODE" "(" NAME ")"

imbed_param:      "IMBED" -> imbed_flag
                 | "NOIMBED" -> noimbed_flag
keyranges_param:  "KEYRANGES" "(" INT+ ")" -> keyranges_ignored
                 | "KEYRANGE"  "(" INT+ ")" -> keyranges_ignored
order_param:      "ORDERED" -> order_ignored_flag
                 | "UNORDERED" -> order_ignored_flag
replicate_param:  "REPLICATE" -> replicate_ignored_flag
                 | "NOREPLICATE" -> replicate_ignored_flag
uniquekey_param:  "UNIQUEKEY" -> uniquekey_flag
                 | "NONUNIQUEKEY" -> nonuniquekey_flag
upgrade_param:    "UPGRADE" -> upgrade_flag
                 | "NOUPGRADE" -> noupgrade_flag

ALTKEY_ACTION: "A" | "D"

BWO_VALUE:      "TYPECICS" | "TYPEIMS" | "NO"
DATABASE_FORMAT: "BSON" | "JSON"
EATTR_VALUE:    "NO" | "OPT"
FRLOG_VALUE:    "ALL" | "NONE" | "REDO" | "UNDO"
LOG_VALUE:      "NONE" | "UNDO" | "ALL"
ORG_VALUE:      "INDEXED" | "LINEAR" | "NONINDEXED" | "NUMBERED" | "ZFS"

NAME:          /[A-Z#@$][A-Z0-9#@$]*(\.[A-Z#@$][A-Z0-9#@$]*)*/
GENERIC_NAME:  /[A-Z#@$][A-Z0-9#@$]*(\.[A-Z#@$][A-Z0-9#@$]*)*\.\*(\.[A-Z#@$][A-Z0-9#@$]*)?/
QUOTED_STRING: /'([^']|'')*'/
HEX_LITERAL:   /X'[0-9A-Fa-f]+'/
BIN_LITERAL:   /B'[01]+'/
INT:           /[0-9]+/

// Whitespace, "-" continuation (whitespace-equivalent), semicolon
// terminator (rest of physical line becomes a comment), and /* */
// comments are all ignorable. "+" continuation is handled by
// preprocess.join_plus_continuations() *before* this grammar ever sees
// the text, not here.
%ignore /[ \t\r\n]+/
%ignore /-[ \t]*(?=\r?\n)/
%ignore /;[^\r\n]*/
%ignore /\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\//
