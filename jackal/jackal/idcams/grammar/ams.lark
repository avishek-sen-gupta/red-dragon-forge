// IDCAMS (Access Method Services) commands: z/OS 3.1 DFSMS Access Method Services Commands.
// Keywords accept their IBM abbreviations (each keyword's "Abbreviation:" entry).

// A record ends a command unless "-" or "+" continues it (AMS p. xxvii).
start: _NL* (command _NL+)* command?

command: _simple | if_matched | if_open
_simple: set_command | cancel_command | define_cluster
       | define_alternateindex | define_gdg | define_nonvsam | define_path
       | delete | alter | repro | print | listcat | export | import_cmd
       | verify | bldindex

value: NAME | GENERIC_NAME | QUOTED_STRING | HEX_LITERAL | BIN_LITERAL | INT

// Modal commands (AMS ch. 2).
set_command: "SET" cc_name ("=" | "EQ") INT

cancel_command: "CANCEL"

// DEFINE CLUSTER (AMS ch. 14)
define_cluster: ("DEFINE" | "DEF") ("CLUSTER" | "CL") "(" _cluster_seq_00 ")" _component_clause*

_component_clause: data_clause | index_clause
data_clause:  "DATA"  "(" _data_seq_0 ")"
index_clause: ("INDEX" | "IX") "(" _index_seq_0 ")"

_cluster_seq_00: _cluster_param _cluster_seq_00
              | _space_choice _cluster_seq_10
              | organization_param _cluster_seq_01
              |
_cluster_seq_10: _cluster_param _cluster_seq_10
              | organization_param _cluster_seq_11
              |
_cluster_seq_01: _cluster_param _cluster_seq_01
              | _space_choice _cluster_seq_11
              |
_cluster_seq_11: _cluster_param _cluster_seq_11
              |

_data_seq_0: _data_param _data_seq_0
          | _space_choice _data_seq_1
          |
_data_seq_1: _data_param _data_seq_1
          |

_index_seq_0: _index_param _index_seq_0
           | _space_choice _index_seq_1
           |
_index_seq_1: _index_param _index_seq_1
           |

_cluster_param: name_param
             | volumes_param
             | account_param
             | bufferspace_param
             | bwo_param
             | catalog_param
             | cisz_param
             | database_format_param
             | keyname_param
             | keynameu_param
             | dataclass_param
             | eattr_param
             | erase_param
             | exceptionexit_param
             | file_param
             | freespace_param
             | frlog_param
             | keylabel_param
             | keys_param
             | log_param
             | logreplicate_param
             | logstreamid_param
             | managementclass_param
             | model_param
             | owner_param
             | recatalog_param
             | recordsize_param
             | reuse_param
             | rls_param
             | shareoptions_param
             | spanned_param
             | speed_param
             | storageclass_param
             | retention_param
             | writecheck_param
             | obsolete_ignored_param

_data_param: name_param
          | volumes_param
          | bufferspace_param
          | cisz_param
          | erase_param
          | exceptionexit_param
          | file_param
          | freespace_param
          | keys_param
          | model_param
          | owner_param
          | recordsize_param
          | reuse_param
          | shareoptions_param
          | spanned_param
          | speed_param
          | writecheck_param
          | obsolete_ignored_param

_index_param: name_param
           | volumes_param
           | cisz_param
           | exceptionexit_param
           | file_param
           | model_param
           | owner_param
           | reuse_param
           | shareoptions_param
           | writecheck_param
           | obsolete_ignored_param

name_param: "NAME" "(" NAME ")"

cylinders_alloc: ("CYLINDERS" | "CYL") "(" INT (INT)? ")"
kilobytes_alloc: ("KILOBYTES" | "KB") "(" INT (INT)? ")"
megabytes_alloc: ("MEGABYTES" | "MB") "(" INT (INT)? ")"
records_alloc:   ("RECORDS" | "REC")   "(" INT (INT)? ")"
tracks_alloc:    ("TRACKS" | "TRK")    "(" INT (INT)? ")"
_space_choice: cylinders_alloc | kilobytes_alloc | megabytes_alloc | records_alloc | tracks_alloc

volumes_param: ("VOLUMES" | "VOL") "(" NAME+ ")"

account_param:       ("ACCOUNT" | "ACCT") "(" NAME ")"
bufferspace_param:   ("BUFFERSPACE" | "BUFSP" | "BUFSPC") "(" INT ")"
bwo_param:           "BWO" "(" BWO_VALUE ")"
catalog_param:       ("CATALOG" | "CAT") "(" NAME ")"
cisz_param:          ("CONTROLINTERVALSIZE" | "CISZ" | "CNVSZ") "(" INT ")"
database_format_param: "DATABASE" "(" DATABASE_FORMAT ")"
keyname_param:       "KEYNAME" "(" NAME ")"
keynameu_param:      "KEYNAMEU" "(" NAME ")"
dataclass_param:     ("DATACLASS" | "DATACLAS") "(" NAME ")"
eattr_param:         "EATTR" "(" EATTR_VALUE ")"
erase_param:         ("ERASE" | "ERAS") -> erase_flag
                    | ("NOERASE" | "NERAS") -> noerase_flag
exceptionexit_param: ("EXCEPTIONEXIT" | "EEXT") "(" NAME ")"
file_param:          "FILE" "(" NAME ")"
freespace_param:     ("FREESPACE" | "FSPC") "(" INT INT ")"
frlog_param:         "FRLOG" "(" FRLOG_VALUE ")"
organization_param:  ("INDEXED" | "IXD") -> indexed_flag
                    | ("NONINDEXED" | "NIXD" | "NUMBERED" | "NUMD" | "LINEAR" | "LIN" | "ZFS") -> other_organization
keylabel_param:      "KEYLABEL" "(" NAME ")"
keys_param:          "KEYS" "(" INT INT ")"
log_param:           "LOG" "(" LOG_VALUE ")"
logreplicate_param:  ("LOGREPLICATE" | "LOGR") -> logreplicate_flag
                    | ("NOLOGREPLICATE" | "NOLOGR") -> nologreplicate_flag
logstreamid_param:   ("LOGSTREAMID" | "LSID") "(" NAME ")"
managementclass_param: ("MANAGEMENTCLASS" | "MGMTCLAS") "(" NAME ")"
model_param:         "MODEL" "(" NAME NAME? ")"
owner_param:         "OWNER" "(" NAME ")"
recatalog_param:     ("RECATALOG" | "RCTLG") -> recatalog_flag
                    | ("NORECATALOG" | "NRCTLG") -> norecatalog_flag
recordsize_param:    ("RECORDSIZE" | "RECSZ") "(" INT INT ")"
reuse_param:         ("REUSE" | "RUS") -> reuse_flag
                    | ("NOREUSE" | "NRUS") -> noreuse_flag
rls_param:           ("RLSQUIESCE" | "RLSQ") -> rlsquiesce_flag
                    | ("RLSENABLE" | "RLSE") -> rlsenable_flag
shareoptions_param:  ("SHAREOPTIONS" | "SHR") "(" INT INT? ")"
spanned_param:       ("SPANNED" | "SPND") -> spanned_flag
                    | ("NONSPANNED" | "NSPND") -> nonspanned_flag
speed_param:         "SPEED" -> speed_flag
                    | ("RECOVERY" | "RCVY") -> recovery_flag
storageclass_param:  ("STORAGECLASS" | "STORCLAS") "(" NAME ")"
retention_param:     "TO" "(" INT ")" -> to_retention
                    | "FOR" "(" INT ")" -> for_retention
writecheck_param:    ("WRITECHECK" | "WCK") -> writecheck_flag
                    | ("NOWRITECHECK" | "NWCK") -> nowritecheck_flag

obsolete_ignored_param: "IMBED" -> obsolete_ignored
                       | "NOIMBED" -> obsolete_ignored
                       | "KEYRANGES" "(" INT+ ")" -> obsolete_ignored
                       | "KEYRANGE" "(" INT+ ")" -> obsolete_ignored
                       | "ORDERED" -> obsolete_ignored
                       | "UNORDERED" -> obsolete_ignored
                       | "REPLICATE" -> obsolete_ignored
                       | "NOREPLICATE" -> obsolete_ignored

// DEFINE ALTERNATEINDEX (AMS ch. 13)
define_alternateindex: ("DEFINE" | "DEF") ("ALTERNATEINDEX" | "AIX") "(" aix_seq_00 ")" aix_component_clause*

aix_component_clause: aixdata_clause | aixindex_clause
aixdata_clause:  "DATA"  "(" aixdata_seq_0 ")"
aixindex_clause: ("INDEX" | "IX") "(" aixindex_seq_0 ")"

altkey_choice: altkeys_param | altkeysu_param

aix_seq_00: aix_param aix_seq_00
          | _space_choice aix_seq_10
          | altkey_choice aix_seq_01
          |
aix_seq_10: aix_param aix_seq_10
          | altkey_choice aix_seq_11
          |
aix_seq_01: aix_param aix_seq_01
          | _space_choice aix_seq_11
          |
aix_seq_11: aix_param aix_seq_11
          |

aixdata_seq_0: aixdata_param aixdata_seq_0
             | _space_choice aixdata_seq_1
             |
aixdata_seq_1: aixdata_param aixdata_seq_1
             |

aixindex_seq_0: aixindex_param aixindex_seq_0
              | _space_choice aixindex_seq_1
              |
aixindex_seq_1: aixindex_param aixindex_seq_1
              |

aix_param: name_param
         | relate_param
         | volumes_param
         | bufferspace_param
         | catalog_param
         | cisz_param
         | dataclass_param
         | erase_param
         | exceptionexit_param
         | file_param
         | freespace_param
         | imbed_param
         | keyranges_param
         | keys_param
         | model_param
         | order_param
         | owner_param
         | recatalog_param
         | recordsize_param
         | replicate_param
         | reuse_param
         | shareoptions_param
         | speed_param
         | retention_param
         | uniquekey_param
         | upgrade_param
         | writecheck_param

aixdata_param: name_param
             | volumes_param
             | attempts_param
             | authorization_param
             | bufferspace_param
             | code_param
             | cisz_param
             | erase_param
             | exceptionexit_param
             | file_param
             | freespace_param
             | keys_param
             | model_param
             | owner_param
             | recordsize_param
             | reuse_param
             | shareoptions_param
             | speed_param
             | uniquekey_param
             | writecheck_param

aixindex_param: name_param
              | volumes_param
              | attempts_param
              | authorization_param
              | code_param
              | cisz_param
              | exceptionexit_param
              | file_param
              | model_param
              | owner_param
              | reuse_param
              | shareoptions_param
              | writecheck_param

relate_param: ("RELATE" | "REL") "(" NAME ")"

altkey_entry: NAME ALTKEY_ACTION
altkeys_param:  "ALTKEYS"  "(" altkey_entry+ ")"
altkeysu_param: "ALTKEYSU" "(" altkey_entry+ ")"

attempts_param:     "ATTEMPTS" "(" INT ")"
authorization_param: "AUTHORIZATION" "(" NAME QUOTED_STRING? ")"
code_param:          "CODE" "(" NAME ")"

imbed_param:      "IMBED" -> imbed_flag
                 | "NOIMBED" -> noimbed_flag
keyranges_param:  "KEYRANGES" "(" INT+ ")" -> keyranges_ignored
                 | "KEYRANGE"  "(" INT+ ")" -> keyranges_ignored
order_param:      "ORDERED" -> order_ignored_flag
                 | "UNORDERED" -> order_ignored_flag
replicate_param:  "REPLICATE" -> replicate_ignored_flag
                 | "NOREPLICATE" -> replicate_ignored_flag
uniquekey_param:  ("UNIQUEKEY" | "UNQK") -> uniquekey_flag
                 | ("NONUNIQUEKEY" | "NUNQK") -> nonuniquekey_flag
upgrade_param:    ("UPGRADE" | "UPG") -> upgrade_flag
                 | ("NOUPGRADE" | "NUPG") -> noupgrade_flag

ALTKEY_ACTION: "A" | "D"

BWO_VALUE:      "TYPECICS" | "TYPEIMS" | "NO"
DATABASE_FORMAT: "BSON" | "JSON"
EATTR_VALUE:    "NO" | "OPT"
FRLOG_VALUE:    "ALL" | "NONE" | "REDO" | "UNDO"
LOG_VALUE:      "NONE" | "UNDO" | "ALL"

// DEFINE GENERATIONDATAGROUP (AMS ch. 15)
define_gdg: ("DEFINE" | "DEF") ("GENERATIONDATAGROUP" | "GDG") "(" _gdg_param* ")" catalog_param?

_gdg_param: name_param
         | limit_param
         | catalog_param
         | empty_param
         | extended_param
         | gdgorder_param
         | owner_param
         | purge_param
         | scratch_param

limit_param:    ("LIMIT" | "LIM") "(" INT ")"
empty_param:    ("EMPTY" | "EMP") -> empty_flag
              | ("NOEMPTY" | "NEMP") -> noempty_flag
extended_param: ("EXTENDED" | "EXT") -> extended_flag
              | ("NOEXTENDED" | "NEXT") -> noextended_flag
gdgorder_param: GDG_ORDER_VALUE
purge_param:    ("PURGE" | "PRG") -> purge_flag
              | ("NOPURGE" | "NPRG") -> nopurge_flag
scratch_param:  ("SCRATCH" | "SCR") -> scratch_flag
              | ("NOSCRATCH" | "NSCR") -> noscratch_flag

GDG_ORDER_VALUE: "FIFO" | "LIFO"

// DEFINE NONVSAM (AMS ch. 16)
define_nonvsam: ("DEFINE" | "DEF") ("NONVSAM" | "NVSAM") "(" nonvsam_param* ")"

nonvsam_param: name_param
             | devicetypes_param
             | nonvsam_volumes_param
             | catalog_param
             | collection_param
             | filesequencenumbers_param
             | owner_param
             | recatalog_param
             | retention_param

devicetypes_param: "DEVICETYPES" "(" DEVICE_TYPE+ ")"

nonvsam_volumes_param: ("VOLUMES" | "VOL") "(" nonvsam_volume_item+ ")"
nonvsam_volume_item: NAME | INDIRECT_VOLUME_STAR | INDIRECT_VOLUME_SYMBOLIC

collection_param: "COLLECTION" -> collection_flag

filesequencenumbers_param: "FILESEQUENCENUMBERS" "(" INT+ ")"

DEVICE_TYPE: /[A-Z0-9#@$]+/
INDIRECT_VOLUME_STAR: "******"
INDIRECT_VOLUME_SYMBOLIC: /&[A-Z0-9#@$]{1,5}/

// DEFINE PATH (AMS ch. 18)
define_path: ("DEFINE" | "DEF") "PATH" "(" path_param* ")"

path_param: name_param
          | pathentry_param
          | catalog_param
          | model_param
          | owner_param
          | recatalog_param
          | retention_param
          | update_param

pathentry_param: ("PATHENTRY" | "PENT") "(" NAME ")"
update_param:    "UPDATE" -> update_flag
               | "NOUPDATE" -> noupdate_flag

// DELETE (AMS ch. 20)
delete: ("DELETE" | "DEL") delete_entries _delete_seq_0

delete_entries: "(" DELETE_ENTRY+ ")" | DELETE_ENTRY

_delete_seq_0: _delete_param _delete_seq_0
            | entry_type_param _delete_seq_1
            |
_delete_seq_1: _delete_param _delete_seq_1
            |

_delete_param: catalog_param
            | erase_param
            | file_param
            | force_param
            | mask_param
            | nodisconnect_param
            | purge_param
            | delete_recovery_param
            | scratch_param

entry_type_param: ("CLUSTER" | "CL" | "ALTERNATEINDEX" | "AIX" | "NONVSAM" | "NVSAM" | "PATH") -> deletable_entry_type
                | ("ALIAS" | "GENERATIONDATAGROUP" | "GDG" | "LIBRARYENTRY" | "NVR" | "PAGESPACE"
                  | "TRUENAME" | "USERCATALOG" | "VOLUMEENTRY" | "VVR") -> other_entry_type

force_param: ("FORCE" | "FRC") -> force_flag
           | ("NOFORCE" | "NFRC") -> noforce_flag
mask_param:  "MASK" -> mask_flag
           | "NOMASK" -> nomask_flag
nodisconnect_param: "NODISCONNECT" -> nodisconnect_flag
delete_recovery_param: ("RECOVERY" | "RCVY") -> delete_recovery_flag
                      | "NORECOVERY" -> delete_norecovery_flag

DELETE_ENTRY: /[A-Z0-9#@$%*](?:[A-Z0-9#@$%*]|\.(?=[A-Z0-9#@$%*+])|\+[ \t]*\r?\n[ \t]*)*/

// ALTER (AMS ch. 5)
alter: "ALTER" NAME alter_seq_0

alter_seq_0: alter_param alter_seq_0
           | catalog_state_choice alter_seq_1
           |
alter_seq_1: alter_param alter_seq_1
           |

catalog_state_choice: "LOCK" -> lock_flag
                     | "UNLOCK" -> unlock_flag
                     | "SUSPEND" -> suspend_flag
                     | "RESUME" -> resume_flag

alter_param: newname_param
           | addvolumes_param
           | removevolumes_param
           | account_param
           | bufferspace_param
           | bufnd_param
           | bufni_param
           | bwo_param
           | catalog_param
           | ccsid_param
           | ecsharing_param
           | empty_param
           | erase_param
           | exceptionexit_param
           | extendedaddressable_param
           | gdgorder_param
           | file_param
           | filedata_param
           | freespace_param
           | alter_frlog_param
           | inhibit_param
           | keys_param
           | limit_param
           | alter_log_param
           | logreplicate_param
           | logstreamid_param
           | managementclass_param
           | nullify_clause
           | owner_param
           | purge_param
           | reclaimca_param
           | recordsize_param
           | reuse_param
           | rls_param
           | rollin_param
           | scratch_param
           | shareoptions_param
           | storageclass_param
           | strno_param
           | retention_param
           | typelinear_param
           | uniquekey_param
           | update_param
           | upgrade_param
           | writecheck_param

newname_param:        "NEWNAME" "(" NAME ")"
addvolumes_param:     "ADDVOLUMES" "(" NAME+ ")"
removevolumes_param:  "REMOVEVOLUMES" "(" NAME+ ")"
bufnd_param:          "BUFND" "(" INT ")"
bufni_param:          "BUFNI" "(" INT ")"
ccsid_param:          "CCSID" "(" INT ")"
ecsharing_param:      "ECSHARING" -> ecsharing_flag
                     | "NOECSHARING" -> noecsharing_flag
extendedaddressable_param: "EXTENDEDADDRESSABLE" -> extendedaddressable_flag
filedata_param:       "FILEDATA" "(" FILEDATA_VALUE ")"
alter_frlog_param:    "FRLOG" "(" ALTER_FRLOG_VALUE ")"
inhibit_param:        "INHIBIT" -> inhibit_flag
                     | "UNINHIBIT" -> uninhibit_flag
alter_log_param:      "LOG" "(" ALTER_LOG_VALUE ")"
reclaimca_param:      "RECLAIMCA" -> reclaimca_flag
                     | "NORECLAIMCA" -> noreclaimca_flag
rollin_param:         "ROLLIN" -> rollin_flag
strno_param:          "STRNO" "(" INT ")"
typelinear_param:     "TYPE" "(" "LINEAR" ")" -> typelinear_flag

FILEDATA_VALUE:     "TEXT" | "BINARY"
ALTER_FRLOG_VALUE:  "NONE" | "REDO"
ALTER_LOG_VALUE:    "NONE" | "UNDO" | "ALL" | "REDO"

nullify_clause: "NULLIFY" "(" nullify_param* ")"

nullify_param: nullify_authorization_param
             | nullify_bwo_param
             | nullify_code_param
             | nullify_exceptionexit_param
             | nullify_log_param
             | nullify_logstreamid_param
             | nullify_managementclass_param
             | nullify_owner_param
             | nullify_retention_param

nullify_authorization_param:   "AUTHORIZATION" "(" NULLIFY_AUTH_VALUE ")"
nullify_bwo_param:             "BWO"
nullify_code_param:            "CODE"
nullify_exceptionexit_param:   ("EXCEPTIONEXIT" | "EEXT")
nullify_log_param:             "LOG"
nullify_logstreamid_param:     ("LOGSTREAMID" | "LSID")
nullify_managementclass_param: ("MANAGEMENTCLASS" | "MGMTCLAS")
nullify_owner_param:           "OWNER"
nullify_retention_param:       "RETENTION"

NULLIFY_AUTH_VALUE: "MODULE" | "STRING"

// REPRO (AMS ch. 30)
repro: "REPRO" _repro_param*

_repro_param: infile_param
           | indataset_param
           | outfile_param
           | outdataset_param
           | entries_param
           | level_param
           | fromkey_param
           | fromaddress_param
           | fromnumber_param
           | skip_param
           | tokey_param
           | toaddress_param
           | tonumber_param
           | count_param
           | encipher_clause
           | decipher_clause
           | insertshift_param
           | insertall_param
           | skipdbcscheck_param
           | nodbcscheck_param
           | repro_cimode_param
           | repro_dbcs_param
           | errorlimit_param
           | file_param
           | mergecat_param
           | messagelevel_param
           | replace_param
           | reuse_param
           | volumeentries_param
           | rlssource_param
           | rlstarget_param

infile_param:     ("INFILE" | "IFILE") "(" NAME ")"
indataset_param:  ("INDATASET" | "IDS") "(" NAME ")"
outfile_param:    ("OUTFILE" | "OFILE") "(" NAME ")"
outdataset_param: ("OUTDATASET" | "ODS") "(" NAME ")"

entries_param: ("ENTRIES" | "ENT") "(" NAME+ ")"
level_param:   "LEVEL" "(" NAME ")"

fromkey_param:     ("FROMKEY" | "FKEY") "(" value ")"
fromaddress_param: "FROMADDRESS" "(" value ")"
fromnumber_param:  "FROMNUMBER" "(" value ")"
skip_param:        "SKIP" "(" value ")"

tokey_param:     "TOKEY" "(" value ")"
toaddress_param: "TOADDRESS" "(" value ")"
tonumber_param:  "TONUMBER" "(" value ")"
count_param:     "COUNT" "(" value ")"

int_pair: "(" INT INT ")"

insertshift_param: "INSERTSHIFT" "(" int_pair+ ")"
insertall_param:   "INSERTALL" -> insertall_flag

skipdbcscheck_param: "SKIPDBCSCHECK" "(" int_pair+ ")"
nodbcscheck_param:   "NODBCSCHECK" -> nodbcscheck_flag

repro_cimode_param: "CIMODE" -> repro_cimode_flag
                   | "NOCIMODE" -> repro_nocimode_flag
repro_dbcs_param:   "DBCS" -> repro_dbcs_flag
errorlimit_param:   "ERRORLIMIT" "(" INT ")"
mergecat_param:      "MERGECAT" -> mergecat_flag
                    | "NOMERGECAT" -> nomergecat_flag
messagelevel_param: "MESSAGELEVEL" "(" MESSAGELEVEL_VALUE ")"
replace_param:       "REPLACE" -> replace_flag
                    | "NOREPLACE" -> noreplace_flag
volumeentries_param: "VOLUMEENTRIES" "(" NAME ")"
rlssource_param: "RLSSOURCE" "(" RLS_STATE_VALUE ")"
rlstarget_param: "RLSTARGET" "(" RLS_STATE_VALUE ")"

MESSAGELEVEL_VALUE: "ALL" | "SHORT"
RLS_STATE_VALUE:    "NO" | "YES" | "QUIESCE"

encipher_clause: "ENCIPHER" "(" cipher_param* ")"

cipher_param: cipherunit_param
            | cipher_datakeyfile_param
            | cipher_datakeyvalue_param
            | shipkeynames_param
            | storedatakey_param
            | storekeyname_param
            | userdata_param
            | externalkeyname_choice
            | internalkeyname_choice
            | privatekey_choice

externalkeyname_choice: "EXTERNALKEYNAME" "(" NAME ")"
internalkeyname_choice: "INTERNALKEYNAME" "(" NAME ")"
privatekey_choice:      "PRIVATEKEY"

cipherunit_param:         "CIPHERUNIT" "(" INT ")"
cipher_datakeyfile_param:  "DATAKEYFILE" "(" NAME ")" -> cipher_datakeyfile
cipher_datakeyvalue_param: "DATAKEYVALUE" "(" (NAME | QUOTED_STRING) ")" -> cipher_datakeyvalue
shipkeynames_param:       "SHIPKEYNAMES" "(" NAME+ ")"
storedatakey_param:        "STOREDATAKEY" -> storedatakey_flag
                          | "NOSTOREDATAKEY" -> nostoredatakey_flag
storekeyname_param:       "STOREKEYNAME" "(" NAME ")"
userdata_param:           "USERDATA" "(" (NAME | QUOTED_STRING) ")"

decipher_clause: "DECIPHER" "(" decipher_param* ")"

decipher_param: systemdatakey_param
              | systemkeyname_param
              | dk_datakeyfile_choice
              | dk_datakeyvalue_choice
              | dk_systemkey_choice

dk_datakeyfile_choice:  "DATAKEYFILE" "(" NAME ")"
dk_datakeyvalue_choice: "DATAKEYVALUE" "(" (NAME | QUOTED_STRING) ")"
dk_systemkey_choice:    "SYSTEMKEY"

systemdatakey_param: "SYSTEMDATAKEY" "(" (NAME | QUOTED_STRING) ")"
systemkeyname_param: "SYSTEMKEYNAME" "(" NAME ")"

// PRINT (AMS ch. 29)
print: "PRINT" print_param*

print_param: infile_param
           | indataset_param
           | outfile_param
           | print_format_param
           | repro_cimode_param
           | repro_dbcs_param
           | fromkey_param
           | fromaddress_param
           | fromnumber_param
           | skip_param
           | tokey_param
           | toaddress_param
           | tonumber_param
           | count_param
           | insertshift_param
           | insertall_param
           | skipdbcscheck_param
           | nodbcscheck_param
           | rlssource_param

print_format_param: "CHARACTER" -> print_character_flag
                   | "DUMP"      -> print_dump_flag
                   | "HEX"       -> print_hex_flag

// LISTCAT (AMS ch. 27)
listcat: ("LISTCAT" | "LISTC") listcat_param*

listcat_param: listcat_entrytype_param
             | libraryentries_param
             | volumeentries_param
             | catalog_param
             | creation_param
             | expiration_param
             | entries_param
             | level_param
             | listcat_cdilvl_param
             | listcat_prefix_param
             | listcat_detail_param
             | file_param
             | library_param
             | outfile_param

listcat_entrytype_param: LISTCAT_ENTRYTYPE_VALUE

LISTCAT_ENTRYTYPE_VALUE: "ALIAS" | "ALTERNATEINDEX" | "AIX" | "CLUSTER" | "CL" | "DATA"
                        | "GENERATIONDATAGROUP" | "GDG" | "INDEX" | "IX" | "NONVSAM"
                        | "PAGESPACE" | "PATH" | "USERCATALOG"

libraryentries_param: "LIBRARYENTRIES" "(" NAME ")"
creation_param:       "CREATION" "(" INT ")"
expiration_param:     "EXPIRATION" "(" INT ")"

listcat_cdilvl_param: "CDILVL" -> cdilvl_flag
                     | "NOCDILVL" -> nocdilvl_flag
listcat_prefix_param: "PREFIX" -> prefix_flag
                     | "NOPREFIX" -> noprefix_flag

listcat_detail_param: LISTCAT_DETAIL_VALUE

LISTCAT_DETAIL_VALUE.-1: "ALLOCATION" | "HISTORY" | "VOLUME" | "NAME" | "ALL"

library_param: "LIBRARY" "(" NAME ")"

// EXPORT (AMS ch. 23)
export: ("EXPORT" | "EXP") NAME export_param*

export_param: outfile_param
            | outdataset_param
            | export_mode_param
            | erase_param
            | infile_param
            | inhibitsource_param
            | inhibittarget_param
            | purge_param
            | export_kind_param
            | rlssource_param

export_mode_param: "CIMODE" -> export_cimode_flag
                  | "RECORDMODE" -> export_recordmode_flag

inhibitsource_param: "INHIBITSOURCE" -> inhibitsource_flag
                    | "NOINHIBITSOURCE" -> noinhibitsource_flag
inhibittarget_param: "INHIBITTARGET" -> inhibittarget_flag
                    | "NOINHIBITTARGET" -> noinhibittarget_flag

export_kind_param: "TEMPORARY" -> export_temporary_flag
                  | "PERMANENT" -> export_permanent_flag

// IMPORT (AMS ch. 25)
import_cmd: "IMPORT" import_param*

import_param: infile_param
            | indataset_param
            | outfile_param
            | outdataset_param
            | alias_param
            | erase_param
            | intoempty_param
            | import_lock_param
            | objects_param
            | purge_param
            | savrac_param
            | catalog_param
            | rlstarget_param

alias_param: "ALIAS" -> alias_flag
           | "NOALIAS" -> noalias_flag
intoempty_param: "INTOEMPTY" -> intoempty_flag
import_lock_param: "LOCK" -> lock_flag
                  | "UNLOCK" -> unlock_flag
savrac_param: "SAVRAC" -> savrac_flag
            | "NOSAVRAC" -> nosavrac_flag

objects_param: "OBJECTS" "(" import_object+ ")"
import_object: "(" NAME import_object_param* ")"
import_object_param: file_param
                    | managementclass_param
                    | newname_param
                    | storageclass_param
                    | volumes_param

// VERIFY (AMS ch. 34)
verify: ("VERIFY" | "VFY") _verify_param*

_verify_param: file_param
            | verify_dataset_param
            | verify_recover_param

verify_dataset_param: ("DATASET" | "DS") "(" NAME ")"
verify_recover_param: "RECOVER" -> verify_recover_flag

// BLDINDEX (AMS ch. 8)
bldindex: ("BLDINDEX" | "BIX") bldindex_param*

bldindex_param: infile_param
              | indataset_param
              | bldindex_outfiles_param
              | bldindex_outdatasets_param
              | bldindex_sort_kind_param
              | bldindex_sortcall_param
              | sortdevicetype_param
              | sortfilenumber_param
              | sortmessagedd_param
              | sortmessagelevel_param
              | workfiles_param
              | catalog_param

bldindex_outfiles_param:    ("OUTFILE" | "OFILE") "(" NAME+ ")"
bldindex_outdatasets_param: ("OUTDATASET" | "ODS") "(" NAME+ ")"

bldindex_sort_kind_param: "EXTERNALSORT" -> externalsort_flag
                        | "INTERNALSORT" -> internalsort_flag

bldindex_sortcall_param: "SORTCALL" -> sortcall_flag
                       | "NOSORTCALL" -> nosortcall_flag

sortdevicetype_param: "SORTDEVICETYPE" "(" DEVICE_TYPE ")"
sortfilenumber_param: "SORTFILENUMBER" "(" INT ")"
sortmessagedd_param:  "SORTMESSAGEDD" "(" NAME ")"
sortmessagelevel_param: "SORTMESSAGELEVEL" "(" SORT_MESSAGE_LEVEL_VALUE ")"
workfiles_param:      "WORKFILES" "(" NAME NAME ")"

SORT_MESSAGE_LEVEL_VALUE: "ALL" | "CRITICAL" | "NONE"

// A THEN or ELSE with nothing after it in its record is the null command; each ELSE
// takes the nearest unmatched THEN (AMS pp. 16-17).
if_matched: _if_head then_closed else_closed
if_open: _if_head then_any
       | _if_head then_closed else_open
_if_head: "IF" cc_name if_op INT "THEN"
then_closed: _closed?
then_any: _any?
else_closed: _NL* "ELSE" _closed?
else_open: _NL* "ELSE" if_open
_closed: _simple | if_matched | do_block
_any: _simple | if_matched | if_open | do_block
do_block: "DO" _NL+ (command _NL+)* "END"

cc_name: "MAXCC"  -> maxcc_field
       | "LASTCC" -> lastcc_field

if_op: "="  -> op_eq
     | "EQ" -> op_eq
     | "¬=" -> op_ne
     | "NE" -> op_ne
     | ">=" -> op_ge
     | "GE" -> op_ge
     | "<=" -> op_le
     | "LE" -> op_le
     | ">"  -> op_gt
     | "GT" -> op_gt
     | "<"  -> op_lt
     | "LT" -> op_lt

// A "+" continues a value onto the next record (AMS p. xxvii).
NAME:          /[A-Z#@$](?:[A-Z0-9#@$]|\.(?=[A-Z#@$+])|\+[ \t]*\r?\n[ \t]*)*/
GENERIC_NAME:  /[A-Z#@$][A-Z0-9#@$]*(\.[A-Z#@$][A-Z0-9#@$]*)*\.\*(\.[A-Z#@$][A-Z0-9#@$]*)?/
QUOTED_STRING: /'([^']|'')*'/
HEX_LITERAL:   /X'[0-9A-Fa-f]+'/
BIN_LITERAL:   /B'[01]+'/
INT:           /[0-9]+/

// Blanks, commas and comments separate (AMS p. xxiv); "-" continues the record.
_NL: /[ \t]*\r?\n/
%ignore /[ \t,]+/
%ignore /-[ \t]*\r?\n/
%ignore /;[^\r\n]*/
%ignore /\/\*[^*]*\*+(?:[^\/*][^*]*\*+)*\//
