@cobol_condition = @cobol_combination | @cobol_relation_test | @cobol_condition_name_test | @cobol_class_test | @cobol_user_class_test | @cobol_sign_test | @cobol_parenthesised | @cobol_unparsed_condition;

@cobol_exec_sql_statement_whenever_action_type = @cobol_go_to | @cobol_continue | @cobol_no_op_action;

@cobol_expr_node = @cobol_literal_node | @cobol_figurative_node | @cobol_all_literal_node | @cobol_address_of_node | @cobol_length_of_node | @cobol_dfh_resp_node | @cobol_all_subscript_node | @cobol_field_ref_node | @cobol_ref_mod_node | @cobol_bin_op_node | @cobol_function_node;

@cobol_goto_statement_form_type = @cobol_simple_goto | @cobol_computed_goto | @cobol_altered_goto;

@cobol_move_statement_source_type = @cobol_ref_mod_operand | @cobol_function_call_operand;

@cobol_perform_spec = @cobol_perform_times_spec | @cobol_perform_until_spec | @cobol_perform_varying_spec;

@cobol_ref_mod_expr = @cobol_ref_mod_literal | @cobol_ref_mod_reference | @cobol_ref_mod_length_of | @cobol_ref_mod_function | @cobol_ref_mod_bin_op;

@cobol_selection_object = @cobol_any_object | @cobol_truth_value | @cobol_selection_condition | @cobol_value_object | @cobol_range_object;

@cobol_selection_subject = @cobol_expression_subject | @cobol_selection_condition | @cobol_truth_value;

