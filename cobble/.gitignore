# Python
__pycache__/
*.pyc
.venv/

# Build artifacts. out-*/ because a private corpus config points out_dir at its
# own directory, and the graph there names that corpus's programs and datasets.
out/
out-*/
cache/
**/target/

# Bridge parse caches (if any land here)
.parse_cache/

# Generated BMS symbolic copybooks (Stage-0 output)
sym/
sym-*/

# Corpus configs for private codebases. A config carries absolute paths and the
# corpus's own member-name globs, so it identifies the codebase it points at —
# only config/carddemo.yaml (a public sample) belongs in the repo.
config/*.local.yaml
# Every depgraph config, not just a .local one. It carries absolute corpus paths
# AND the pass-through set, whose entries are that corpus's own working-storage
# field names -- as identifying as a path. The example shape lives in
# cobble/dataflow/depgraph/config.py's docstring, so nothing is lost by keeping
# all of these out.
config/*.toml
# ...but an .example.toml carries no absolute paths and no corpus identifiers: it is
# the only documentation of a config's shape, so it has to be in the repo.
!config/*.example.toml

# Local tool builds (hlasm_export and friends, when built from here)
tools/

# Eclipse / JDT language-server project files, generated per-machine for the
# two Maven bridges. Maven's pom.xml is the build definition, not these.
.classpath
.project
.settings/

# Generated by maven-shade-plugin on every package of the two bridges. Shade
# serializes <properties> in hash order, so it rewrites itself on each build.
dependency-reduced-pom.xml
