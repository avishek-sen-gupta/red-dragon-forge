[importlinter]
root_packages =
    cobble

# graph_types is the Node/Edge vocabulary every consumer speaks, so an import of
# it is not a dependency on the knowledge_graph builders. It imports nothing but
# stdlib and cobble.file_location, which the contract below pins.
[importlinter:contract:graph-types-is-leaf-vocabulary]
name = graph_types must not import the rest of cobble
type = forbidden
source_modules =
    cobble.knowledge_graph.graph_types
forbidden_modules =
    cobble.cics
    cobble.jcl
    cobble.diagnosis
    cobble.corpus_index
    cobble.corpus_index_builder
    cobble.build_graph

[importlinter:contract:consumer-independence]
name = cics, jcl, and knowledge_graph must not import each other
type = independence
modules =
    cobble.cics
    cobble.jcl
    cobble.knowledge_graph
ignore_imports =
    cobble.** -> cobble.knowledge_graph.graph_types

# The split of corpus_index into lookup (here) plus corpus_index_builder exists
# so this holds: populating the index needs the JCL and CSD parsers, and both of
# those packages consume the index. With both halves in one module that was a
# real cycle, held apart only by the consumers' TYPE_CHECKING guards.
[importlinter:contract:corpus-index-is-lookup-only]
name = corpus_index must not import the graph consumers
type = forbidden
source_modules =
    cobble.corpus_index
forbidden_modules =
    cobble.cics
    cobble.jcl
    cobble.knowledge_graph
ignore_imports =
    cobble.corpus_index -> cobble.knowledge_graph.graph_types
