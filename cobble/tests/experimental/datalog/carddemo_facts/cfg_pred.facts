COSGN00C	READ-USER-SEC-FILE/1.when.0.0.then.5.else.0#raise	%HANDLER[ANY]	==	RAISED	%HANDLER[ANY] RAISED	yes
COSGN00C	READ-USER-SEC-FILE/1.when.0.0.then.5.then.0#raise	%HANDLER[ANY]	==	RAISED	%HANDLER[ANY] RAISED	yes
