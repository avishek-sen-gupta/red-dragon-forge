// Program reachability: which programs a transaction can run, through XCTL, CALL, links and resolved targets.
#ifndef RULES_PROGRAMS_DL
#define RULES_PROGRAMS_DL
#include "schema.dl"

.decl hands_to(a:symbol, b:symbol, how:symbol)
hands_to(A,B,K) :- kg_edge(A,K,B), (K="XCTL"; K="XCTL_CANDIDATE"; K="CALL").
hands_to(A,B,T) :- link(A,_,T,B,_,_,_,_).
hands_to(A,B,T) :- target(A,_,"program",T,_,B).
.decl runs(t:symbol, p:symbol)
runs(T,P) :- kg_edge(T,"STARTS",P), kg_node(T,"TRANSACTION").
runs(T,Q) :- runs(T,P), hands_to(P,Q,_).
#endif
