// Gaps that leave an answer about a site's program incomplete: not settled, dead ends, unresolved guards, unmodelled writes.
#ifndef RULES_GAPS_DL
#define RULES_GAPS_DL
#include "guards.dl"

.decl gap(p:symbol, what:symbol, detail:symbol)
gap(P,"not-settled","") :- site(P,_), fp_counts(P,"no",_,_,_,_,_,_).
gap(P,"dead-end",W) :- site(P,_), fp_dead_end(P,W).
gap(P,"unresolved-guard",D) :- guard(P,_,D,_,_,"no").
gap(P,"unmodelled-writes",to_string(U)) :- site(P,_), fp_counts(P,_,_,_,_,U,_,_), U > 0.
#endif
