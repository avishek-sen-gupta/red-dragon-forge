// Byte walks through the partition graph from stated target_bytes(slot, start, end), downstream and upstream; an unaligned edge means the whole field.
#ifndef RULES_BYTES_DL
#define RULES_BYTES_DL
#include "schema.dl"

.decl target_bytes(slot:symbol, start:number, end:number)
.decl flows(a:symbol, b:symbol)
flows(A,B) :- slot_edge(A,B,_,_,_).
flows(A,C) :- flows(A,B), slot_edge(B,C,_,_,_).
.decl aligned(x:symbol, y:symbol)
aligned(X,Y) :- slot_align(X,Y,_,_,_).
.decl downstream(x:symbol, s:number, e:number)
downstream(D,S,E) :- target_bytes(D,S,E).
downstream(Y,YS,YE) :- downstream(X,S,E), slot_align(X,Y,SO,TO,L), LO = max(S,SO), HI = min(E,SO+L), LO < HI, YS = TO+LO-SO, YE = TO+HI-SO.
downstream(Y,0,Z) :- downstream(X,_,_), slot_edge(X,Y,_,_,_), !aligned(X,Y), slot(Y,_,_,_,_,_,Z).
.decl upstream(x:symbol, s:number, e:number)
upstream(D,S,E) :- target_bytes(D,S,E).
upstream(X,XS,XE) :- upstream(Y,S,E), slot_align(X,Y,SO,TO,L), LO = max(S,TO), HI = min(E,TO+L), LO < HI, XS = SO+LO-TO, XE = SO+HI-TO.
upstream(X,0,Z) :- upstream(Y,_,_), slot_edge(X,Y,_,_,_), !aligned(X,Y), slot(X,_,_,_,_,_,Z).
#endif
