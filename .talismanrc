  # update, so a checksum entry is self-defeating. Ignore content detection
  # outright rather than churn this file. (Deviates from talismanrc append-only
  # for this generated-file case.)
  ignore_detectors: [filecontent]
- filename: beads/issues.jsonl
  # Generated snapshot of the Beads issue graph (scripts/export-issues.sh).
  # Regenerated on every issue change, so a checksum is self-defeating; ignore
  # content detection like uv.lock.
  ignore_detectors: [filecontent]
