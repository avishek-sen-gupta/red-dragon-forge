# .gitignore), but ignore any stray copies/symlinks at the jackal level too.
*.jar
**/target/
dependency-reduced-pom.xml

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

