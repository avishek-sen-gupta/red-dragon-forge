# Python
__pycache__/
*.pyc
.venv/

# Build artifacts
out/
cache/
**/target/

# Bridge parse caches (if any land here)
.parse_cache/

# Generated BMS symbolic copybooks (Stage-0 output)
sym/
sym-*/

# Corpus configs for private codebases. A config carries absolute paths and the
# corpus's own member-name globs, so it identifies the codebase it points at —
# only config/carddemo.yaml (a public sample) belongs in the repo.
config/*.local.yaml

# Generated ANTLR CICS parser (from cobble/cics/cics_grammar/*.g4)
cobble/cics/cics_grammar/CICSzLexer.py
cobble/cics/cics_grammar/CICSzParser.py
cobble/cics/cics_grammar/CICSzParserListener.py
cobble/cics/cics_grammar/CICSzParserVisitor.py
cobble/cics/cics_grammar/*.interp
cobble/cics/cics_grammar/*.tokens
tools/

# Eclipse / JDT language-server project files, generated per-machine for the
# two Maven bridges. Maven's pom.xml is the build definition, not these.
.classpath
.project
.settings/
