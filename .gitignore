jackal_*/
*.log

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads issue tracker DB (kept out of git, per project convention)
.beads/

# SDD subagent handoff files (briefs/reports/ledger/diffs) — local, not committed
.sdd/
