    "COSGN00C::READ-USER-SEC-FILE/1.when.0.0.then.5.then.0" [label="CICS_XCTL COADM01C", shape=box3d, style=filled, fillcolor="#d5e8d4"];
    "COSGN00C::READ-USER-SEC-FILE/1.when.0.0.then.5.then.0#raise" [label="%HANDLER[ANY] RAISED", shape=diamond, style=filled, fillcolor="#fff2cc"];
    "COSGN00C::READ-USER-SEC-FILE/1.when.0.0.then.5.then.0#dispatch" [label="HANDLE DISPATCH", shape=box3d, style=filled, fillcolor="#d5e8d4"];
    "COSGN00C::READ-USER-SEC-FILE/1.when.0.0.then.5.else.0" [label="CICS_XCTL COMEN01C", shape=box3d, style=filled, fillcolor="#d5e8d4"];
    "COSGN00C::READ-USER-SEC-FILE/1.when.0.0.then.5.else.0#raise" [label="%HANDLER[ANY] RAISED", shape=diamond, style=filled, fillcolor="#fff2cc"];
